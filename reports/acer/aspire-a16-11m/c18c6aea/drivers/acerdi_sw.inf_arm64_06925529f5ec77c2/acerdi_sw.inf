; INF: acerdi_sw.inf
;--*/

[Version]
Signature = "$Windows NT$"
Class = SoftwareComponent
ClassGuid = {5c4c3332-344d-483c-8739-259e934c9cc8}
Provider = %ManufacturerName%
CatalogFile = acerdi_sw.cat
DriverVer = 11/12/2025,1.3.12.1012
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = ADISWComponent, NTAMD64.10.0...22000, NTARM64.10.0...22000

[ADISWComponent.NTAMD64.10.0...22000]
%DeviceName% = ADISWComponent_Install, SWC\SWComp_AcerDeviceInfoSW2Driver

[ADISWComponent.NTARM64.10.0...22000]
%DeviceName% = ADISWComponent_Install, SWC\SWComp_AcerDeviceInfoSW2Driver

[SourceDisksFiles]
AcerDIAgent.exe = 1
Launcher.exe = 1
server_crt.pem = 1
server_key.pem = 1

[SourceDisksNames]
1 = %ACCExtensionDisc%

[DestinationDirs]
ADIService_CopyFiles = 11 ; %SystemRoot%\system32
ADIService_DelFiles = 11 ; %SystemRoot%\system32
ADISWComponent_CopyFiles = 11, AcerDIAgent ; %ProgramFiles%\AcerDIAgent
ADISWComponent_DelFiles = 11, AcerDIAgent ; %ProgramFiles%\AcerDIAgent

[ADISWComponent_Install.NT]
CopyFiles = ADIService_CopyFiles, ADISWComponent_CopyFiles
DelFiles = ADIService_DelFiles, ADISWComponent_DelFiles

[ADISWComponent_Install.NT.Services]
AddService = , 0x00000002
AddService = AcerDIAgentSvis, 0x00000800, ADISWComponent_ServiceInstall

[ADISWComponent_ServiceInstall]
DisplayName   = %ServiceName%
Description   = %ServiceDesc%
ServiceType   = 0x00000010
StartType     = 2                        ; SERVICE_WIN32_OWN_PROCESS
ErrorControl  = 1                        ; SERVICE_AUTO_START
DelayedAutoStart = 1                     ; Automatic delayed start for WOA
ServiceBinary = "%11%\AcerDIAgent.exe"

[ADIService_CopyFiles]
AcerDIAgent.exe

[ADISWComponent_CopyFiles]
;AcerDIAgent.exe
Launcher.exe
server_crt.pem
server_key.pem

[ADIService_DelFiles]
AcerDIAgent.exe

[ADISWComponent_DelFiles]
AcerDIAgent.exe
Launcher.exe
server_crt.pem
server_key.pem

[Strings]
ManufacturerName = "Acer Incorporated"
ServiceName      = "Acer Device Info"
ServiceDesc      = "Acer Device Info Service"
ACCExtensionDisc = "Acer Device Info Software Component Disk"
DeviceName = "Acer Device Info Software Component"
