[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %OEM%
ExtensionId = {EBAD45F3-9085-4932-A374-77EEB10F4643}
DriverVer   = 09/25/2024,2.0.10.0
CatalogFile = dtsapo5Acerextensionpkg.cat
pnplockdown=1

[SourceDisksNames]
1 = %DiskId1%,,,
222 = %DiskId1%,,,\bin
333 = %DiskId1%,,,\data
444 = %DiskId1%,,,\xml
1070911 = %DiskId1%,,,\Acer1025179A

[SourceDisksFiles]
DefaultSettings.bin=222
CurrentSettings.bin=333
DAP2-WinARM64.dtsc=444
ProductConfiguration.dtsc=444
dts_apo5x_license_1025179A.lic=1070911
TuningPackage.dtsc=1070911

[DestinationDirs]
Bin.CopyList = 11,DTS\PC\APO5x\bin ; %windir%\system32\DTS\PC\APO5x\bin
Data.CopyList = 11,DTS\PC\APO5x\data ; %windir%\system32\DTS\PC\APO5x\data
Xml.CopyList = 11, DTS\PC\APO5x\xml ; %windir%\system32\DTS\PC\APO5x\xml
DefaultDestDir = 11, DTS\PC\APO5x\xml ; %windir%\system32\DTS\PC\APO5x\xml
Lic.CopyList = 11, DTS\PC\APO5x\licenses ; %windir%\system32\DTS\PC\APO5x\licenses

[Bin.CopyList]
DefaultSettings.bin

[Data.CopyList]
CurrentSettings.bin

[Xml.CopyList]
DAP2-WinARM64.dtsc
ProductConfiguration.dtsc

[Lic.CopyList]
dts_apo5x_license_1025179A.lic

[Acer1025179A.CopyList]
TuningPackage.dtsc

[Manufacturer]
%OEM% = DeviceExtensions,NTARM64.10.0...26080

[DeviceExtensions.NTARM64.10.0...26080]
%Device.ExtensionDesc% = Acer1025179A,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_CRD08380
%Device.ExtensionDesc% = Acer1025179A,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_1025179A
%Device.ExtensionDesc% = Acer1025179A,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_1025179B

[Acer1025179A]
CopyFiles = Lic.CopyList,Bin.CopyList,Data.CopyList,Data.CopyList,Xml.CopyList
CopyFiles = Acer1025179A.CopyList

[Acer1025179A.Components]
AddComponent = DTSAPO,,DTSAPO_Install
AddComponent = DTSService,,DTSService_Install
AddComponent = DTSHSA,,DTSDAP2HSA_Install
AddComponent = DTSSUB,,DTSSUBHSA_Install

[Acer1025179A.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,TopologySpeaker,DTS.DAP2.Reg
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologySpeaker,DTS.DAP2.Reg
AddInterface=%KSCATEGORY_AUDIO%,TopologySpeakerHeadset,DTS.DAP2.Reg
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologySpeakerHeadset,DTS.DAP2.Reg

[DTS.DAP2.Reg]
AddReg = DTSAPO.Reg
AddReg = DTS.DAP2.PresetAddRegQcom

[DTSAPO.Reg]
;; APO CLSID registration for render endpoints
HKR,"FX\0",%PKEY_CompositeFX_StreamEffectClsid%,%REG_MULTI_SZ%,%DTS_SFX_CLSID%
HKR,"FX\0",%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%DTS_MFX_CLSID%
;;HKR,"FX\0",%PKEY_CompositeFX_EndpointEffectClsid%,%REG_MULTI_SZ%,%DTS_EFX_CLSID%
HKR,"FX\0",%PKEY_CompositeFX_Offload_StreamEffectClsid%,%REG_MULTI_SZ%,%DTS_OSFX_CLSID%
HKR,"FX\0",%PKEY_CompositeFX_Offload_ModeEffectClsid%,%REG_MULTI_SZ%,%DTS_OMFX_CLSID%

HKR,"FX\0",%PKEY_SFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATION%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,"FX\0",%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATION%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
;;HKR,"FX\0",%PKEY_EFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATION%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,"FX\0",%PKEY_SFX_Offload_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATION%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,"FX\0",%PKEY_MFX_Offload_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATION%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%


[DTS.DAP2.PresetAddRegQcom]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XSFX_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XSFX_PS_CONTEXT%\User,,,

HKR,FX\0\%DTSAPO5XMFX_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XMFX_PS_CONTEXT%\User,,,

;;HKR,FX\0\%DTSAPO5XEFX_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
;;HKR,FX\0\%DTSAPO5XEFX_PS_CONTEXT%\User,,,

HKR,FX\0\%DTSAPO5XOSFX_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XOSFX_PS_CONTEXT%\User,,,

HKR,FX\0\%DTSAPO5XOMFX_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XOMFX_PS_CONTEXT%\User,,,

HKR,FX\0\%DTSAPO5XGLOBAL_PS_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%DTSAPO5XGLOBAL_PS_CONTEXT%\User,,,

[DTSAPO_Install]
ComponentIDs = VEN_DTSI&AID_DTSIAPO5X
Description = "DTS Audio Effects Component APO5x"

[DTSService_Install]
ComponentIDs = VEN_DTSI&HID_DTSIAPO5xSERVICE
Description = "DTS APO5x Service Component"

[DTSDAP2HSA_Install]
ComponentIDs = VEN_DTSI&HID_DTSIDAP2
Description = "DTS Audio Hardware Support Application"

[DTSSUBHSA_Install]
ComponentIDs = VEN_DTSI&HID_DTSISUB
Description = "DTS SUB Hardware Support Application"

