[Version]
Signature   = "$WINDOWS NT$"
Class       = SoftwareComponent
ClassGuid   = {5c4c3332-344d-483c-8739-259e934c9cc8}
Provider    = %OEM%
DriverVer   = 05/07/2024,0.1.0.0
CatalogFile = DtsHubService.cat
PnpLockdown = 1

[SourceDisksNames]
222 = %DiskId1%

[SourceDisksFiles]
dts-general-purpose-translator-shared.dll=222
DtsUserSettingsPlugin.dll=222
DtsHubService.exe=222

[SignatureAttributes]
dts-general-purpose-translator-shared.dll=SignatureAttributes.PETrust
DtsUserSettingsPlugin.dll=SignatureAttributes.PETrust
DtsHubService.exe=SignatureAttributes.PETrust

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%OEM% = DTSService,NTARM64

[DTSService.NTARM64]
%Service.ComponentDesc% = DTSService_InstallArm64,SWC\VEN_DTSI&HID_DTSIAPO5xSERVICE

[DestinationDirs]
Bin.CopyList         =11, DTS\PC\APO5x\bin
Translators.CopyList =11, DTS\PC\APO5x\bin\translators

[DTSService_InstallArm64]
CopyFiles = Bin.CopyList, Translators.CopyList

[DTSService_InstallArm64.Services]
AddService = ,2  ; to mask Infverif warning
AddService = DtsHubService, 0x00000800, DTS_Usersrv_ServiceInstall

[Bin.CopyList]
DtsHubService.exe
DtsUserSettingsPlugin.dll

[Translators.CopyList]
dts-general-purpose-translator-shared.dll

[DTS_Usersrv_ServiceInstall]
DisplayName    = "DtsHubService"
ServiceType    = 0x00000010      ; SERVICE_WIN32_SHARE_PROCESS
StartType      = 0x2             ; SERVICE_AUTO_START
ErrorControl   = 0x1             ; SERVICE_ERROR_NORMAL
ServiceBinary  = %11%\DTS\PC\APO5x\bin\DtsHubService.exe "%11%\DTS\PC\APO5x\xml\ProductConfiguration.dtsc" "%11%\DTS\PC\APO5x\xml\TuningPackage.dtsc" "%11%\DTS\PC\APO5x\bin\sdks" "%11%\DTS\PC\APO5x\bin\translators" "%11%\DTS\PC\APO5x\data\CurrentSettings.bin" "%11%\DTS\PC\APO5x\xml\DAP2-WinARM64.dtsc" "%11%\DTS\PC\APO5x\bin\DefaultSettings.bin"

[Strings]
OEM                   = "DTS"
Service.ComponentDesc = "DTS Hub Service"
DiskId1               = "DTS APO5x Service Installation Disk"
