[ADIExtension.NTARM64.10.0...22000]
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_12031025 ; Aspire
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_12041025 ; Swift
