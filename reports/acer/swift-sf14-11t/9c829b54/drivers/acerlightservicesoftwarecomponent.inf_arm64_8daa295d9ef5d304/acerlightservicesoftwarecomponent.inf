;
; AcerLightServiceSoftwareComponent.inf
;
[Version]
Signature="$WINDOWS NT$"
Class=SoftwareComponent
ClassGuid={5c4c3332-344d-483c-8739-259e934c9cc8}
Provider=%ProviderString%
DriverVer = 01/30/2026,2.0.1013.4
CatalogFile.NTamd64=AcerLightServiceSoftwareComponentamd64.cat
CatalogFile.NTarm64=AcerLightServiceSoftwareComponentarm64.cat
PnpLockDown=1
; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=Microsoft,NTamd64.10.0...19041,NTarm64.10.0...19041

; Works on Win7 and later because we use inbox HID-KMDF mapper
[Microsoft.NTamd64.10.0...19041]
%DeviceDesc%=AcerLightService_x64,  SWC\VEN_1025&DEV_165F&SWComp_AcerLightServiceDriver
%DeviceDesc%=DynamicLightingService,  SWC\VEN_1025&DEV_165F&SWComp_PredatorLightServiceDriver

[Microsoft.NTarm64.10.0...19041]
%DeviceDesc%=AcerLightService_arm64,  SWC\VEN_1025&DEV_165F&SWComp_AcerLightServiceDriver

[AcerLightService_x64]
CopyFiles=ExeCopy
CopyFiles=FramesCopy
CopyFiles=ExeCopy.NTamd64

[AcerLightService_arm64]
CopyFiles=ExeCopy
CopyFiles=FramesCopy
CopyFiles=ExeCopy.NTarm64

[AcerLightService_x64.Services]
;AddService=AcerLightService,	0x00000002,	AcerLightService_Service_Inst,
AddService=,0x00000002,
AddService=ALSSvc, 0x00000800, ALSSvc_x64_ServiceInstall

[AcerLightService_arm64.Services]
;AddService=AcerLightService,	0x00000002,	AcerLightService_Service_Inst,
AddService=,0x00000002,
AddService=ALSSvc, 0x00000800, ALSSvc_arm64_ServiceInstall

[DynamicLightingService]
CopyFiles=ExeCopy
CopyFiles=ExeCopy.NTamd64

[DynamicLightingService.Services]
;AddService=AcerLightService,	0x00000002,	AcerLightService_Service_Inst,
AddService=,0x00000002,
AddService=ALSSvc, 0x00000800, ALSSvc_x64_ServiceInstall

[DynamicLightingService.Software]
AddSoftware=AcerLightingBackgroundController, , AcerLightingBackground_Controller_Inst

;[AcerLightService_Service_Inst]
;DisplayName    = %ServiceDesc%
;ServiceType    = 1
;StartType      = 3
;ErrorControl   = 1
;ServiceBinary  = %13%\AcerLightServiceSoftwareComponent.sys

[ALSSvc_x64_ServiceInstall]
DisplayName    = "Acer Lighting Component"
ServiceType    = 0x00000010      ; SERVICE_WIN32_SHARE_PROCESS
StartType      = 2               ; SERVICE_AUTO_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\x64\AcerLightingComponent.exe

[ALSSvc_arm64_ServiceInstall]
DisplayName    = "Acer Lighting Component"
ServiceType    = 0x00000010      ; SERVICE_WIN32_SHARE_PROCESS
StartType      = 2               ; SERVICE_AUTO_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\ARM64\AcerLightingComponent.exe

[AcerLightingBackground_Controller_Inst]
SoftwareType=2
SoftwareID=pfn://AcerIncorporated.AcerLightingBackgroundController_48frkmn4z8aw4

;[AcerLightService.Wdf]
;KmdfService=AcerLightService, AcerLightService_wdfsect

;[AcerLightService_wdfsect]
;KmdfLibraryVersion=$KMDFVERSION$

;[DefaultUninstall.Services]
;DelService=ALSSvc, 0x200

; ================= copy files =====================
[ExeCopy]

[ExeCopy.NTamd64]
AcerLightingComponent.exe
AcerLightingBackgroundApp.exe

;MS Libraries
msvcp140.dll
vcruntime140.dll
