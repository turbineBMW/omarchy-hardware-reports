[DeviceExtension_Install.NT]
; No files to copy for this extension INF

[DeviceExtension_Install.NT.HW]
AddReg = DeviceExtension_HWAddReg

[DeviceExtension_HWAddReg]
; Set the friendly name for the device
HKR,,FriendlyName,,%DeviceFriendlyName%

[AddHwKey]
; No changes

[AddHwKey.HW]
AddReg=AddHardwareKey

[AddHardwareKey]
HKR,,"CollectionReenumerateSelfInterfaceEnabled",0x00010001,0x1

[Strings]
ManufacturerName      = "XBOX"
DeviceExtensionName   = "XBOX Synthetic Device Extension"
DeviceFriendlyName    = "XBOX Synthetic Gamepad"
HidDeviceName         = "XBOX Gamepad Device Extension"
