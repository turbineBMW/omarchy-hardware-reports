[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer = 10/08/2025,2025.10.08.0
CatalogFile = voicemodvad.cat
PnpLockDown = 1

[SourceDisksNames]
222="VOICEMODVAD Driver Disk","",222

[SourceDisksFiles]
voicemodvad.sys=222

[Manufacturer]
%MfgName%=VOICEMODVAD,NTARM64.10.0...19041

[VOICEMODVAD.NTARM64.10.0...19041]
%VOICEMODVAD_DRIVER.DeviceDesc%=VOICEMODVAD_DRIVER, ROOT\voicemodvad

[DestinationDirs]
VOICEMODVAD_DRIVER.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; VOICEMODVAD_DRIVER
;======================================================
[VOICEMODVAD_DRIVER.CopyList]
voicemodvad.sys

[VOICEMODVAD_DRIVER.AddReg]
HKR,,AssociatedFilters,,"wdmaud,redbook"
HKR,,Driver,,voicemodvad.sys

HKR,Drivers,SubClasses,,"wave,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%VOICEMODVAD_DRIVER.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%VOICEMODVAD_DRIVER.DeviceDesc%

HKR,%MEDIA_CATEGORIES%\%SpeakerCustomNameGUID%,Name,,%SpeakerCustomName%
;======================================================
; capture interfaces: mic array (internal: front)
;======================================================
[VOICEMODVAD.I.WaveMicArray1]
AddReg=VOICEMODVAD.I.WaveMicArray1.AddReg
[VOICEMODVAD.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VOICEMODVAD.WaveMicArray1.szPname%

[VOICEMODVAD.I.TopologyMicArray1]
AddReg=VOICEMODVAD.I.TopologyMicArray1.AddReg

[VOICEMODVAD.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VOICEMODVAD.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; render interfaces: speaker (internal)
;======================================================
[VOICEMODVAD.I.WaveSpeaker]
AddReg=VOICEMODVAD.I.WaveSpeaker.AddReg

[VOICEMODVAD.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VOICEMODVAD.WaveSpeaker.szPname%

[VOICEMODVAD.I.TopologySpeaker]
AddReg=VOICEMODVAD.I.TopologySpeaker.AddReg

[VOICEMODVAD.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VOICEMODVAD.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000105

;======================================================
; VOICEMODVAD_DRIVER
;======================================================
[VOICEMODVAD_DRIVER.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=VOICEMODVAD_DRIVER.CopyList
AddReg=VOICEMODVAD_DRIVER.AddReg

[VOICEMODVAD_DRIVER.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, VOICEMODVAD.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, VOICEMODVAD.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, VOICEMODVAD.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, VOICEMODVAD.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, VOICEMODVAD.I.TopologySpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_TopologySpeaker%, VOICEMODVAD.I.TopologySpeaker

;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, VOICEMODVAD.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, VOICEMODVAD.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, VOICEMODVAD.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, VOICEMODVAD.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, VOICEMODVAD.I.TopologyMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_TopologyMicArray1%, VOICEMODVAD.I.TopologyMicArray1

[VOICEMODVAD_DRIVER.NT.Services]
AddService=voicemodvad,0x00000002,VoicemodVAD_Service_Inst

[VoicemodVAD_Service_Inst]
DisplayName=%voicemodvad.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\voicemodvad.sys

[VOICEMODVAD_DRIVER.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[VOICEMODVAD_DRIVER.NT.Wdf]
KmdfService = voicemodvad, VOICEMOD_DRIVER_WdfSect
[VOICEMOD_DRIVER_WdfSect]
KmdfLibraryVersion = 1.15

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"

KSNAME_WaveMicArray1="WaveMic"
KSNAME_TopologyMicArray1="TopologyMic"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association                   = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioDevice_NeverSetAsDefaultEndpoint       = "{F3E80BEF-1723-4FF2-BCC4-7F83DC5E46D4},3"
PKEY_AudioEndpoint_Supports_EventDriven_Mode     = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

MEDIA_CATEGORIES = "MediaCategories"
SpeakerCustomNameGUID = {0e408bd1-9800-40f5-8895-66b3ac6b2df6}

;Localizable

ProviderName = "Voicemod S.L."
MfgName      = "Voicemod S.L."
MsCopyRight  = "Voicemod S.L."

VOICEMODVAD_DRIVER.DeviceDesc="Voicemod"
voicemodvad.SvcDesc="Voicemod Driver"

;; friendly names
VOICEMODVAD.WaveSpeaker.szPname="Wave Speaker"
VOICEMODVAD.TopologySpeaker.szPname="Topology Speaker"

VOICEMODVAD.WaveMicArray1.szPname="Wave Microphone"
VOICEMODVAD.TopologyMicArray1.szPname="Topology Microphone"

SpeakerCustomName= "Dummy Output"

