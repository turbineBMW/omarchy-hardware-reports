;===================================================================
; Surface APO Driver Extension
; Copyright (c)2020, Microsoft Corporation
;===================================================================
[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId = {06FF0735-E049-447F-B701-879A3DE533C4}
Provider    = %SURFACE_APO_ProviderName%
DriverVer = 01/15/2026,1.216.97.0
CatalogFile = SurfaceAPOExtension.cat
PnpLockDown = 1

[SourceDisksNames]
1 = Disk

[SourceDisksFiles]
SurfaceAPO_883.json = 1

[DestinationDirs]
Config_CopyFiles = 13 ; Driver Package's DriverStore Directory

[Manufacturer]
%SURFACE_APO_MfgName% = DeviceExtensions,NTARM64.10.0...19041

[DeviceExtensions.NTARM64.10.0...19041]
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_883, QCASD\VEN_QCOM&DEV_0FCD&SUBSYS_MSHW0777&REV_0A
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_883, QCASD\VEN_QCOM&DEV_0FCD&SUBSYS_MSHW0777&REV_0B

[DeviceExtension_Install_Surface_883.NT]
CopyFiles = Config_CopyFiles

[DeviceExtension_Install_Surface_883.NT.Components]
AddComponent = SurfaceApo,,SurfaceApo_AddComponent

[DeviceExtension_Install_Surface_883.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_Speaker%, SurfaceAPO_Install_883
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_Speaker%, SurfaceAPO_Install_883
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_Speaker%, SurfaceAPO_Install_883
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_Speaker%, SurfaceAPO_Install_883

;======================================================
; APO per-interface registry
;======================================================
[SurfaceAPO_Install_883]
AddReg = APO.I.Association0.AddReg_Common,APO.I.Association0.AddReg_883

[APO.I.Association0.AddReg_883]
HKR,FX\0\%SURFACE_APO_CONTEXT%\Default,%PKEY_SurfaceApoConfigFilename%,%REG_SZ%,%13%\SurfaceAPO_883.json

[APO.I.Association0.AddReg_Common]
; for installing on QC
HKR,FX\0\%SURFACE_APO_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%SURFACE_APO_CONTEXT%\User,%PKEY_SurfaceApoEnableMteMode%,%REG_DWORD%,0
;HKR,FX\0,%PKEY_FX_ModeEffectClsid%,,%SURFACE_RENDER_MFX_CLSID%
;HKR,FX\0,%PKEY_FX_Offload_ModeEffectClsid%,,%SURFACE_RENDER_MFX_CLSID%
;HKR, "FX\\0", %PKEY_MFX_Offload_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_RAW%
;HKR, "FX\\0", %PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_RAW%
; Set SAF proxy settings
; No SAF proxy for this product configuration

[Config_CopyFiles]
SurfaceAPO_883.json

[SurfaceApo_AddComponent]
ComponentIds = VEN_MSFT&PID_SURFACEAPO ; HWID: SWC\VEN_MSFT&PID_SURFACEAPO

