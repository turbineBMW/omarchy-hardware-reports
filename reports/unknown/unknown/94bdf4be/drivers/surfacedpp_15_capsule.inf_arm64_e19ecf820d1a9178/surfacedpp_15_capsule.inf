[Firmware_AddReg]

HKR,,FirmwareId,,{8042C870-FC5A-4A6F-BF20-2F44D05D4BA6}
HKR,,FirmwareVersion,%REG_DWORD%,1


[Firmware_Install.NT.Services]
AddService =  ,2


[Strings]
; localizable
