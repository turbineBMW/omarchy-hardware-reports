DriverVer   = 04/04/1975,1.0.7.0
CatalogFile = SurfaceDPPCapsule.cat
PnpLockdown = 1

[Manufacturer]
%MfgName% = Firmware,NTARM64.10.0...19041

[Firmware.NTARM64.10.0...19041]
%FirmwareDesc_DPP_15IN%             = Firmware_Install,UEFI\RES_{8042C870-FC5A-4A6F-BF20-2F44D05D4BA6}

[Firmware_Install.NT]
CopyFiles = Firmware_CopyFiles

[Firmware_CopyFiles]

[Firmware_Install.NT.Hw]
