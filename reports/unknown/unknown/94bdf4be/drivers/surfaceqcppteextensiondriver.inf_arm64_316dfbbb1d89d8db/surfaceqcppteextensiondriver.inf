;/*++
;
;Copyright (c) Microsoft Corporation.  All rights reserved.
;
;Module Name:
;    SurfaceQcPPTEExtensionDriver.inx
;
;Abstract:
;    Extension INF file for Qualcomm PPTE service.
;    Sets registry parameters for Scenario Based Optimization (SBO) features.
;
;--*/

[Version]
Signature   = "$Windows NT$"
Class       = Extension
ClassGUID   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %ManufacturerName%
ExtensionId = {a1cd21fa-1bf6-4dc1-92e4-97a1e81dc739}
DriverVer = 04/29/2026,0.0.9.0
CatalogFile = qcppte_extension8480.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%

[Manufacturer]
%ManufacturerName% = Standard,NTARM64.10.0...22621

[Standard.NTARM64.10.0...22621]
%SurfaceQCPPTEExt.DeviceDesc% = SurfaceQCPPTEExt_Base, ACPI\QCOM1042

[SurfaceQCPPTEExt_Base.NT]
; empty

[SurfaceQCPPTEExt_Base.NT.HW]
AddReg = SurfaceQCPPTEExt_Base_AddReg

[SurfaceQCPPTEExt_Base_AddReg]
HKR, Parameters, SBO, 0x00010001, 0x0000003F
HKR, Parameters, SBOApplicationLaunch, 0x00010001, 0x0000003F
HKR, Parameters, SBOTopologyOptimize, 0x00010001, 0x0000003F
HKR, Parameters, SBOVideoOptimize, 0x00010001, 0x0000003F
HKR, Parameters, SBOApplications, 0x00010001, 0x0000003F
HKR, Parameters, SBOThreadBoost, 0x00010001, 0x0000003F

HKR, Parameters, IgnoredApplications, 0x00000002, ""
HKR, Parameters, DisableRegKeyOverrides, 0x00010001, 1

[SurfaceQCPPTEExt_Base.NT.Components]
AddComponent = qcppte_extension8480,, SurfaceQCPPTEExt_Component_Inst
Description = %SurfaceQCPPTEExt.DeviceDesc%

[SurfaceQCPPTEExt_Component_Inst]
ComponentIDs = QCOM1042

;*****************************************
; Strings section
;*****************************************

[Strings]
;  *******Localizable Strings*******
ManufacturerName              = "Surface"
DiskName                      = "Surface PPTE Extension Installation Disk"
SurfaceQCPPTEExt.DeviceDesc   = "Surface PPTE Service Extension"

;Non-Localizable
REG_EXPAND_SZ          = 0x00020000
REG_DWORD              = 0x00010001
REG_MULTI_SZ           = 0x00010000
REG_BINARY             = 0x00000001
REG_SZ                 = 0x00000000
