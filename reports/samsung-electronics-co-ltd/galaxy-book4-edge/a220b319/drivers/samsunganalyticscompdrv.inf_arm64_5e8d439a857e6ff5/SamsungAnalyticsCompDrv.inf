;-------------- Service installation
[SamsungAnalyticsService_Device.Services]
AddService = , 0x00000002
AddService = SamsungAnalyticsService, 0x00000800, SamsungAnalyticsService_Inst
AddService = DqaService, 0x00000800, DqaService_Inst

;-------------Samsung Analytics Service Installation--------
[SamsungAnalyticsService_Inst]
DisplayName = %SamsungAnalyticsServiceDisplayName%
ServiceType = 0x00000010
StartType = 2
ErrorControl = 1
ServiceBinary = %12%\SamsungAnalyticsAgentDriver\SamsungAnalyticsService\SamsungAnalyticsService.exe

;-------------DQA Service Installation--------
[DqaService_Inst]
DisplayName = %DqaServiceDisplayName%
ServiceType = 0x00000010
StartType = 2
ErrorControl = 1
ServiceBinary = %12%\SamsungAnalyticsAgentDriver\DqaService\DqaService.exe

[Strings]
ManufacturerName="Samsung Electronics Co.,Ltd."
ClassName="SoftwareComponent" 
DiskName = "Samsung Analytics Agent Installation Disk"
SamsungAnalyticsService.DeviceDesc = "Samsung Analytics Agent Device"
SamsungAnalyticsServiceDisplayName = "Samsung Analytics Agent - SA"
DqaServiceDisplayName = "Samsung Analytics Agent - DQA"
