[Version]
Signature="$WINDOWS NT$"
Class=SoftwareComponent
ClassGuid={5c4c3332-344d-483c-8739-259e934c9cc8}
Provider=%ManufacturerName%
CatalogFile=samsunganalyticscompdrv.cat
DriverVer = 11/07/2025,3.0.6.0
PnpLockDown = 1

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=SamsungAnalyticsService,NTamd64,NTARM64

[SamsungAnalyticsService.NTamd64]
%SamsungAnalyticsService.DeviceDesc%=SamsungAnalyticsService_Device, SWC\SAM0430&SWC_SAA

[SamsungAnalyticsService.NTARM64]
%SamsungAnalyticsService.DeviceDesc%=SamsungAnalyticsService_Device, SWC\SAM0430&SWC_SAA

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
;Samsung Analytics Service destination
common-logger-release.logger = 1, SamsungAnalyticsService
e_sqlcipher.dll = 1, SamsungAnalyticsService
e_sqlite3.dll = 1, SamsungAnalyticsService
global.json = 1, SamsungAnalyticsService
LoopbackServiceRegister.bat = 1, SamsungAnalyticsService
LoopbackServiceUnregister.bat = 1, SamsungAnalyticsService
