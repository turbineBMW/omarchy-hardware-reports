SamsungAnalyticsService.Domain.pri = 1, SamsungAnalyticsService
SamsungAnalyticsService.exe = 1, SamsungAnalyticsService
SamsungAnalyticsService.Infrastructure.dll.config = 1, SamsungAnalyticsService
SamsungAnalyticsService.Infrastructure.pri = 1, SamsungAnalyticsService
common-logger-debug.logger = 1, SamsungAnalyticsService

