;
; EgisFP.inf
;

[Version]
Signature="$Windows NT$"
Class=Biometric
ClassGuid={53D29EF7-377C-4D14-864B-EB3A85769359}
Provider=%EGIS%
CatalogFile=egistouchfp05A1.cat
DriverVer = 10/07/2024,1.2.28.0
PnpLockdown=1

[Manufacturer]
%EGIS%=Standard,NTARM64

[Standard.NTARM64]
%EGISUsbDeviceName%=Biometric_Install, USB\VID_1C7A&PID_05A1
%EGISTECBootloader%=Biometric_Install, USB\VID_1C7A&PID_1000

[SourceDisksFiles]
EgisTouchFP05A1.dll=1
EgisTouchFPAdapter05A1.dll=1
EgisTouchFPEventLog05A1.dll=1

[SourceDisksNames]
1 = %MediaDescription%

; =================== UMDF Device ==================================

[Biometric_Install.NT]
CopyFiles=UMDriverCopy, WinBioAdapterCopy
AddProperty=Device_Properties
Include=WINUSB.INF                      ; Import sections from WINUSB.INF
Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF
FeatureScore=0xFE;

[Biometric_Install.NT.hw]
AddReg=Biometric_Device_AddReg
AddReg=DriverPlugInAddReg, DatabaseAddReg, ContactSensor_AddReg, LayoutAddReg

[Device_Properties]
DeviceIcon,,,,"%12%\UMDF\EgisTouchFP05A1.dll,101" ; This is where a device specific icon can be specified.

[Biometric_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall
AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  ; this service is installed because its a filter.
AddService=ET05A1EvtSvc,0x000009f8,EventLog_ServiceInstall

[Biometric_Install.NT.Wdf]
KmdfService=WINUSB, WinUsb_Install
UmdfDispatcher=WinUsb
UmdfService=EgisTouchFP05A1,Biometric_Install
UmdfServiceOrder=EgisTouchFP05A1
UmdfHostProcessSharing=ProcessSharingDisabled

[WinUsb_Install]
KmdfLibraryVersion = 1.9

[Biometric_Install.NT.CoInstallers]
AddReg=CoInstallers_AddReg

[Biometric_Install]
UmdfLibraryVersion=2.15.0 
;DriverCLSID = "{9864FE59-05A1-42FC-B845-689F5A0794C6}"
ServiceBinary=%12%\UMDF\EgisTouchFP05A1.dll

[Biometric_Device_AddReg]
HKR,,"DeviceCharacteristics",0x10001,0x0100     ; Use same security checks on relative opens
HKR,,"Security",,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"  ; Allow generic-all access to Built-in administrators and Local system
HKR,,"LowerFilters",0x00010008,"WinUsb" ; FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND
HKR,,"Exclusive",0x10001,1
HKR,,"WinUsbPowerPolicyOwnershipDisabled",0x00010001,1  ; our driver takes ownership of power policy.  Tell WINUSB not to
; When the UMDF Idle/Wake APIs are called with WdfDefault setting
; These keys tell UMDF to enable idle and wake by default
HKR,WudfPowerPolicySettings,"WdfDefaultIdleInWorkingState",0x00010001,1
HKR,WudfPowerPolicySettings,"WdfDefaultWakeFromSleepState",0x00010001,0
HKR,"WDF","WdfDirectedPowerTransitionEnable",0x00010001,1

[DriverPlugInAddReg]
HKR,,"Exclusive",0x10001,1
HKR,WinBio\Configurations,DefaultConfiguration,,"0"
HKR,WinBio\Configurations,VirtualSecureConfiguration,0x00010001,0x00000001
HKR,WinBio\Configurations,SecureFingerprint,0x00010001,0x00000001
HKR,WinBio\Configurations\0,SensorMode,0x00010001,0x00000001                    ; Basic - 1, Advanced - 2
HKR,WinBio\Configurations\0,SystemSensor,0x00010001,0x00000001                  ; UAC/Winlogon - 1
HKR,WinBio\Configurations\0,SensorAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\0,EngineAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\0,StorageAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\0,DatabaseId,,"01BE2559-05A1-4CDA-ABD5-C9992404DA3A"
HKR,WinBio\Configurations\1,SensorMode,0x00010001,0x00000002                    ; Basic - 1, Advanced - 2
HKR,WinBio\Configurations\1,SystemSensor,0x00010001,0x00000001                  ; UAC/Winlogon - 1
HKR,WinBio\Configurations\1,SensorAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\1,EngineAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\1,StorageAdapterBinary,,"EgisTouchFPAdapter05A1.dll"
HKR,WinBio\Configurations\1,DatabaseId,,"01BE2559-E5A1-4CDA-ABD5-C9992404DA3A"
HKR,WinBio\Configurations\1,VsmEngineAdapterBinary,,"WinBioVsmNullAdapter"
HKR,WinBio\Configurations\1,VsmSensorAdapterBinary,,"WinBioVsmNullAdapter"
HKR,WinBio\Configurations\1,VsmStorageAdapterBinary,,"WinBioVsmNullAdapter"
HKR,WinBio\Configurations\1,VirtualSecureMode,0x00010001,0x00000001 

[DatabaseAddReg]
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},BiometricType,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},Attributes,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},Format,,"00000000-0000-0000-0000-000000000000"
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},InitialSize,0x00010001,0x00000020
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},AutoCreate,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},AutoName,0x00010001,0x00000001
;HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},FilePath,,""
;HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A1-4CDA-ABD5-C9992404DA3A},ConnectionString,,""
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},BiometricType,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},Attributes,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},Format,,"3B2F61F2-D8DF-40AF-B5A0-DDC0A6BCF589"
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},InitialSize,0x00010001,0x00000020
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},AutoCreate,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},AutoName,0x00010001,0x00000001
;HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},FilePath,,""
;HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A1-4CDA-ABD5-C9992404DA3A},ConnectionString,,""

[ContactSensor_AddReg]
;HKR,EgisTouchFP05A1,"CALIBRATION_TYPE",0x00010001,0
;HKR,EgisTouchFP05A1,"CALIBRATION_DATE",0x00000000,"\0"
HKR,EgisTouchFP05A1,"MESSAGE_LEVEL",0x00010001,0x01

[ContactSensor_AddReg.security]
"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GAKA;;;WD)"

[LayoutAddReg]
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A1,location,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A1,powerbutton,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A1,shape,0x00010001,0x00000002


[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys
LoadOrderGroup = Base

[WinUsb_ServiceInstall]
DisplayName     = %WinUsb_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[EventLog_ServiceInstall]
DisplayName     = "EgisTec event log service"
ServiceType     = 0x10
StartType       = 2
ErrorControl    = 1
ServiceBinary   = "%11%\Rundll32.exe %12%\UMDF\EgisTouchFPEventLog05A1.dll,Rundll32EntryPointW"

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WUDFCoinstaller.dll"

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to \Windows\System32\drivers\UMDF
WinBioAdapterCopy=11,WinBioPlugins ; copy to \Windows\System32\WinBioPlugins

[UMDriverCopy]
EgisTouchFP05A1.dll
EgisTouchFPEventLog05A1.dll

[WinBioAdapterCopy]
EgisTouchFPAdapter05A1.dll

[SignatureAttributes] 
EgisTouchFPAdapter05A1.dll = SignatureAttributes.WindowsHello
 
[SignatureAttributes.WindowsHello] 
WindowsHello = true 

; =================== Generic ==================================

[Strings]
EGIS="Egis Technology Inc."
ClassName="Biometric Device"
MediaDescription = "Egis Technology Inc. Biometric Driver Installation Media"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
EGISUsbDeviceName="EgisTec Touch Fingerprint Sensor"
EGISTECBootloader="EGISTEC BOOTLOADER"
WinUsb_SvcDesc="WinUSB Driver"
