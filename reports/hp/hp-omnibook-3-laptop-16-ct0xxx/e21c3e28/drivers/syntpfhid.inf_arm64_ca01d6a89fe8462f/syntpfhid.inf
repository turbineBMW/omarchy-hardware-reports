[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
CatalogFile = SynTP.cat
PnpLockDown=1
DriverVer=05/12/2026, 19.5.35.129

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
SynTPUWP.sys  = 1

[DestinationDirs]
