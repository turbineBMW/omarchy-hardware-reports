[hpcustomcapcomp_Install.ntamd64.Services]
AddService = HPSysInfoCap, 0x00000800, HPSysInfoCap_Service_Inst64, 
AddService = HPAppHelperCap, 0x00000800, HPAppHelperCap_Service_Inst64, 
AddService = HPNetworkCap, 0x00000800, HPNetworkCap_Service_Inst64, 
AddService = HPDiagsCap, 0x00000800, HPDiagsCap_Service_Inst64, 
AddService = , 0x00000002

[HPSysInfoCap_Service_Inst64]
DisplayName    = %ServiceSysInfoDesc%
Description    = "Allows HP apps and services to obtain system WMI, BIOS and device info, configure hardware,access Windows registry, return battery PCM info,access the file system, install services, listen for Windows events, and manage device consents to light up features and services."
ServiceType    = 0x00000010
StartType      = %SERVICE_AUTO_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
LoadOrderGroup = "AudioGroup"
ServiceBinary  = %13%\x64\SysInfoCap.exe
Dependencies   = rpcss,ProfSvc

[HPAppHelperCap_Service_Inst64]
DisplayName    = %ServiceAppHelperDesc%
Description    = "Provides HP apps and services the ability to launch interdependent apps, suspend/resume devices for short periods, adjust network resources to optimize performance, enable presence aware sensors to light up additional features and services."
ServiceType    = 0x00000010
StartType      = %SERVICE_AUTO_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
LoadOrderGroup = "AudioGroup"
ServiceBinary  = %13%\x64\AppHelperCap.exe
Dependencies   = rpcss,ProfSvc

[HPNetworkCap_Service_Inst64]
DisplayName    = %ServiceNetworkDesc%
Description    = "Connects to HP cloud services to manage registration and sync device consents."
ServiceType    = 0x00000010
StartType      = %SERVICE_AUTO_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
LoadOrderGroup = "AudioGroup"
ServiceBinary  = %13%\x64\NetworkCap.exe
Dependencies   = rpcss,ProfSvc

[HPDiagsCap_Service_Inst64]
DisplayName    = %ServiceDiagsDesc%
Description    = "Enables HP apps and services to run device hardware and software diagnostics and troubleshoot problems."
ServiceType    = 0x00000010
StartType      = %SERVICE_AUTO_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
LoadOrderGroup = "AudioGroup"
ServiceBinary  = %13%\x64\DiagsCap.exe
Dependencies   = rpcss,ProfSvc

