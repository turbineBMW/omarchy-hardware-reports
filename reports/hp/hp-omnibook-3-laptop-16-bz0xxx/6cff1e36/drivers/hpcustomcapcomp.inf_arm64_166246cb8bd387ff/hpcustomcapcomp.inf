EXE.CopyList.ntx86.10.0...16299 = 13, x86
EXE.CopyList.ntarm64.10.0...16299 = 13, ARM64

[Manufacturer]
%Mfg% = HP, ntamd64.10.0...16299, ntx86.10.0...16299, ntarm64.10.0...16299

