; Subsystem Driver Install Section
;*****************************************

[Manufacturer]
%QUALCOMM%=Extension,NTARM64.10.0...17763

[Extension.NTARM64.10.0...17763]
%ADSP.DeviceDesc%=SUBSYS_Device_ADSP_ext, ACPI\VEN_QCOM&DEV_0F1B&SUBSYS_CRD08480
%ADSP.DeviceDesc%=SUBSYS_Device_ADSP_ext, ACPI\VEN_QCOM&DEV_0F1B&SUBSYS_HA080001
%ADSP.DeviceDesc%=SUBSYS_Device_ADSP_ext, ACPI\VEN_QCOM&DEV_0F1B&SUBSYS_CDPS8480
%ADSP.DeviceDesc%=SUBSYS_Device_ADSP_ext, ACPI\VEN_QCOM&DEV_0F1B&SUBSYS_QCB08480
%PIL.DeviceDesc%=PIL_Device_Ext, ACPI\VEN_QCOM&DEV_0FFB&SUBSYS_CRD08480
%PIL.DeviceDesc%=PIL_Device_Ext, ACPI\VEN_QCOM&DEV_0FFB&SUBSYS_HA080001
%PIL.DeviceDesc%=PIL_Device_Ext, ACPI\VEN_QCOM&DEV_0FFB&SUBSYS_CDPS8480
%PIL.DeviceDesc%=PIL_Device_Ext, ACPI\VEN_QCOM&DEV_0FFB&SUBSYS_QCB08480
%PDSR.DeviceDesc%=PDSR_Device_JSN_EXT,ACPI\VEN_QCOM&DEV_0FFA&SUBSYS_CRD08480
%PDSR.DeviceDesc%=PDSR_Device_JSN_EXT,ACPI\VEN_QCOM&DEV_0FFA&SUBSYS_HA080001
%PDSR.DeviceDesc%=PDSR_Device_JSN_EXT,ACPI\VEN_QCOM&DEV_0FFA&SUBSYS_CDPS8480
%PDSR.DeviceDesc%=PDSR_Device_JSN_EXT,ACPI\VEN_QCOM&DEV_0FFA&SUBSYS_QCB08480

[SUBSYS_Device_ADSP_ext.NT]
CopyFiles=SOFiles_ADSP,Files_ADSP
AddReg=SUBSYSReg

[SUBSYS_Device_ADSP_ext.NT.HW]
AddReg=SUBSYSReg_common,HashMapping_ADSP,ADSP_PDInfo,ADSP_Children,SUBSYSReg_ADSP_HW

[Files_ADSP]
qcadsp8480.mbn
adsp_dtbs.elf
RADS.bin

[SUBSYSReg]
;Image path for ADSP image
HKR,ADSP,"ImagePath",%REG_SZ%,"%13%\qcadsp8480.mbn"
HKR,ADSP,"RPE_RestartingClientList",%REG_MULTI_SZ%,"GLINK_ADSP:%GUID_ADSP_DEVINTERFACE_GLINK%","ADCODR:%GUID_ADCODR%","SLIMBUS:%GUID_SLM%","ASCD:%GUID_ASCD%"
HKR,ADSP,"RPE_PreShutdownClientList",%REG_MULTI_SZ%,"SLIMBUS:%GUID_SLM%"
;Interfaces needed by ADSP
HKR,ADSP,"Interfaces",%REG_MULTI_SZ%,%GUID_DEVINTERFACE_PIL_TZ%,%GUID_DEVINTERFACE_FASTRPC%,%GUID_DEVINTERFACE_GLINK%,%GUID_TFTP_INTERFACE%
;MANU
HKR,ADSP,"MANU",%REG_DWORD%,0x06be0baf
; WDOG bite workaround handling configuration
HKR,ADSP,"IgnoreWdogEnabled",%REG_DWORD%,0x1
;Reg key to control how subsystem state-machine react to system shutdown
; 0 - Skip tearing down subsystem and end state-machine
; 1 - Teardown (gracefully/forcibly as per SubsystemTeardownType registry config) subsystem before ending state-machine
HKR,ADSP,"SubsystemShutdownType",%REG_DWORD%,0x1
;Reg key to indicate if DTB is supported by Subsystem
; 0 - DTB image is not supported
; 1 - DTB image is supported
HKR,ADSP,"IsDTBImageSupported",%REG_DWORD%,0x1
; DTB image path for Subsystem
HKR,ADSP,"DTBImagePath",%REG_SZ%,"%13%\adsp_dtbs.elf"
;Reg key to control the method used to teardown the subsystem
; 0 - Subsystem teardown needs to be done in a forceful way.
; 1 - Subsystem teardown needs to be done in a graceful way.
HKR,ADSP,"SubsystemTeardownType",%REG_DWORD%,0x1
;Reg key to indicate if SSCTL based graceful shutdown request is supported by Subsystem
; 1 - Supported
; 0 - Unsupported
HKR,ADSP,"SHUT",%REG_DWORD%,0x1

[SUBSYSReg_common]
HKR,,"WaitForVolStartupAppComplete",%REG_DWORD%,1
;PathMappingKeyName defines the subkey name under protocol key,
;where subsys will look for local-remote path mappings. The default value is "Default".
;If overwritten by OEMs, they must ensure to generate path mappings under this subkey.
;If defined, subsys looks under HKR,Mappings\<Protocol>\<PathMappingKeyName> instead of HKR,Mappings\<Protocol>
;This value can have maximum length of 128 excluding NULL character.
HKR,Mappings,"PathMappingKeyName",%REG_SZ%,"Default"

HKR,,FriendlyName,,%ADSP_FriendlyName%

[SUBSYSReg_ADSP_HW]
;Image path for resource bin
HKR,Resources,"BinaryPath",%REG_SZ%, %13%\RADS.bin
[PIL_Device_Ext.NT]

[PIL_Device_Ext.NT.HW]
Addreg=PIL_Reg_common,PIL_Reg_MSM

[PIL_Reg_common]
HKR ,SubsystemLoad\ADSP,MemoryAlignment,%REG_DWORD%,0x00100000
; Gets auto populated with the actual image size during NH patching process
HKR ,SubsystemLoad\ADSP_DTB,MemoryAlignment,%REG_DWORD%,0x40000
; Note: Maintaining this table here for understanding the translation of CHRV bit position to CHRV bitmask.
; |- - - - - - | - - - - - - - -- | - - - - - - - -- |
; | SKU        | CHRV Bit Position| CHRVBitmask      |
; |- - - - - - | - - - - - - - -- | - - - - - - - -- |
; | No ADSP    | 7th bit is set   | 0x00000080       |
; |- - - - - - | - - - - - - - -- | - - - - - - - -- |
HKR ,SubsystemLoad\ADSP,CHRVBitmask,%REG_DWORD%,0x00000080
HKR ,SubsystemLoad\ADSP_DTB,CHRVBitmask,%REG_DWORD%,0x00000080

[PIL_Reg_MSM]
; Gets auto populated with the actual image size during NH patching process
HKR ,SubsystemLoad\ADSP,MemoryReservation,%REG_DWORD%,0x3A00000
HKR ,SubsystemLoad\ADSP_DTB,MemoryReservation,%REG_DWORD%,0x36000

[PDSR_Device_JSN_EXT.NT]
AddReg=PDSRReg_common,JSON_PathMapping
CopyFiles=JSON_Files

[PDSR_Device_JSN_EXT.NT.HW]

[PDSRReg_common]
HKR, PDToSubsysDeviceMapping\audio,"SubsysDevice",%REG_SZ%,"\Device\SUBSYS_ADSP"
HKR, PDToSubsysDeviceMapping\sensor,"SubsysDevice",%REG_SZ%,"\Device\SUBSYS_ADSP"

[ADSP_PDInfo]
HKR,PDInfo,"NumPDs",%REG_DWORD%,0x00000002
HKR,PDInfo\0,"ServiceName",%REG_SZ%,%AUDIO_SERVICE_NAME%
HKR,PDInfo\0,"GUID",%REG_SZ%,%GUID_AUDIO_PD%
HKR,PDInfo\0,"FileNameWildCard",%REG_SZ%,"pd_dump*audio*.elf"
HKR,PDInfo\0,"RootDirectory",%REG_SZ%,"\DriverData\QUALCOMM\TFTP\rfs\msm\adsp\ramdumps\"
HKR,PDInfo\0,"CountFile",%REG_SZ%,"pd_dump_audio_process.count"
HKR,PDInfo\0,"RPE_PDRRestartingClientList",%REG_MULTI_SZ%,"ADCODR:%GUID_ADCODR%","SLIMBUS:%GUID_SLM%","ASCD:%GUID_ASCD%"

HKR,PDInfo\1,"ServiceName",%REG_SZ%,%SENSOR_SERVICE_NAME%
HKR,PDInfo\1,"GUID",%REG_SZ%,%GUID_SENSOR_PD%
HKR,PDInfo\1,"FileNameWildCard",%REG_SZ%,"pd_dump*qsh*.elf"
HKR,PDInfo\1,"RootDirectory",%REG_SZ%,"\DriverData\QUALCOMM\TFTP\rfs\msm\adsp\ramdumps\"
HKR,PDInfo\1,"CountFile",%REG_SZ%,"pd_dump_qsh_process.count"

[ADSP_Children]
HKR,ChildDescriptor\0,"DeviceObjectName",%REG_SZ%,"SLM1"
HKR,ChildDescriptor\0,"_HID",%REG_SZ%,"QCOM0F0F"
HKR,ChildDescriptor\0,"_UID",%REG_DWORD%,0
HKR,ChildDescriptor\0,"DeviceType",%REG_DWORD%,0x0000001D
HKR,ChildDescriptor\0,"SupriseRemoval",%REG_DWORD%,1
HKR,ChildDescriptor\0,"ChildRemoval",%REG_DWORD%,1
HKR,ChildDescriptor\0,"FriendlyName",%REG_SZ%,"Slimbus Device 0"
HKR,ChildDescriptor\0,"SurpriseRemovePD",%REG_SZ%,%GUID_AUDIO_PD%

HKR,ChildDescriptor\1,"DeviceObjectName",%REG_SZ%,"ADCM"
HKR,ChildDescriptor\1,"_HID",%REG_SZ%,"QCOM0F22"
HKR,ChildDescriptor\1,"_UID",%REG_DWORD%,0
HKR,ChildDescriptor\1,"DeviceType",%REG_DWORD%,0x0000001D
HKR,ChildDescriptor\1,"SupriseRemoval",%REG_DWORD%,1
HKR,ChildDescriptor\1,"ChildRemoval",%REG_DWORD%,1
HKR,ChildDescriptor\1,"FriendlyName",%REG_SZ%,"Audio Device"
HKR,ChildDescriptor\1,"SurpriseRemovePD",%REG_SZ%,%GUID_AUDIO_PD%


