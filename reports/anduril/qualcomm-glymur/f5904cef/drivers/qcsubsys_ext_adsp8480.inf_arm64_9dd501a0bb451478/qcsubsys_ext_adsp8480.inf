ADSP.DeviceDesc = "Qualcomm Audio DSP Subsystem Device"
PIL.DeviceDesc = "Qualcomm(R) Peripheral Image Loader Device"
PDSR.DeviceDesc = "Qualcomm(R) Protection Domain Service Registry Device"
