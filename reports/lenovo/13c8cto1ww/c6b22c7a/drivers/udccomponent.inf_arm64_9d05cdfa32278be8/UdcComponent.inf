;
; iMDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = SoftwareComponent
ClassGuid   = {5c4c3332-344d-483c-8739-259e934c9cc8}
Provider=%ManufacturerName%
CatalogFile="udccomponent.cat"
DriverVer=08/18/2026,26.9.1.4
PnpLockdown = 1

[Manufacturer]
%ManufacturerName%=Standard,NTarm64

[Standard.NTarm64]
%DeviceName%=LnvAppFrmDevice_Install, SWC\UdsUdcDriverComponent


[SourceDisksNames]
6 = %DiskName%,,,


; =================== UMDF Device ==================================

[LnvAppFrmDevice_Install.NTarm64]
CopyFiles=PluginFiles, DriverInstaller, CabFiles_1

[LnvAppFrmDevice_Install.NTarm64.Services]
AddService = ,2 ; null service install

[LnvAppFrmDevice_Install.NT.Software]
AddSoftware = ContosoGrfx1CtrlPnl,, Software_Inst

[Software_Inst]
SoftwareType = 1
SoftwareBinary = %12%\lenovo\udc\service\udcInfInstaller.exe
SoftwareArguments = <<DeviceInstanceID>>
SoftwareVersion = 2.0.0.0

[DestinationDirs]
PluginFiles=16425, drivers\Lenovo\udc\AddOnPlugins
DriverInstaller=16425, drivers\Lenovo\udc\DriverInstaller
CabFiles_1=16425, drivers\Lenovo\Udc\AddOnPlugins\618bf3cf-e6b6-4f49-a338-d564c832d07f\x64\vantageservice


; =================== Generic ==================================

[Strings]
ManufacturerName="Lenovo" 
DiskName = "Lenovo UDC Driver Installation Disk"
UdcSvcDisplayName="Universal Device Client Service"
DeviceName="Universal Device Client Device Plugins"
DeviceNameMP="Universal Device Client Device"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"

[DriverInstaller]
msvcp140.dll
vcruntime140.dll
vcruntime140_1.dll
driverinstaller.exe

;============= Specific =========================================
