; =================== UMDF Device ==================================
[LnvAppFrmDevice_InstallWin10.NTarm64]
CopyFiles=Crt, udcService, arm64_udcService, Data, infhlpr_udcService, coretelemetryplugin, udcPluginHost, systemnotificationplugin, messagingplugin, messagingpluginResources, embeddedScripts, x64_embeddedUtilities, arm64_embeddedUtilities, arm64_udcPluginHost, messagingpluginVantageDependency

[LnvAppFrmDevice_InstallWin11.NTarm64]
CopyFiles=Crt, udcService, arm64_udcService, Data, infhlpr_udcService, coretelemetryplugin, udcPluginHost, systemnotificationplugin, messagingplugin, messagingpluginResources, embeddedScripts, x64_embeddedUtilities, arm64_embeddedUtilities, arm64_udcPluginHost, messagingpluginVantageDependency
Include=WUDFRD.inf
Needs=WUDFRD.NT

[LnvAppFrmDevice_InstallWin11.NTarm64.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW

[LnvAppFrmDevice_InstallWin10.NTarm64.Wdf]
UmdfService=Udcdriver,Udcdriver_Install
UmdfServiceOrder=Udcdriver
UmdfHostProcessSharing=ProcessSharingDisabled

[LnvAppFrmDevice_InstallWin11.NTarm64.Wdf]
UmdfService=Udcdriver,Udcdriver_Install
UmdfServiceOrder=Udcdriver
UmdfHostProcessSharing=ProcessSharingDisabled

[Udcdriver_Install]
UmdfLibraryVersion=2.15.0 
ServiceBinary=%12%\UMDF\hidtelephony.dll

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys
LoadOrderGroup = Base

[LnvAppFrmDevice_InstallWin10.NTarm64.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall
AddService="UDCService",0x000000f8,UDC_ServiceInstall
AddService="UDCInstallerService",0x000008f8,UDC_InstallerServiceInstall

[LnvAppFrmDevice_InstallWin11.NTarm64.Services]
AddService="UDCService",0x000000f8,UDC_ServiceInstall
AddService="UDCInstallerService",0x000008f8,UDC_InstallerServiceInstall
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[UDC_ServiceInstall]
DisplayName=%UdcSvcDisplayName%
ServiceType = 0x10
StartType = 2
ErrorControl = 1
ServiceBinary = %16425%\drivers\Lenovo\udc\Service\UDClientService.exe
Description="The Universal Device Client Service provides deployment, event management and metrics etc"

[UDC_InstallerServiceInstall]
DisplayName = UDC Installer Service
ServiceType = 0x10
StartType = 2
ErrorControl = 1
ServiceBinary = %16425%\drivers\Lenovo\udc\Service\UDCInfInstaller.exe
Description = "UDC Installer Service"

[LnvAppFrmDevice_InstallWin10.NTarm64.Components]
AddComponent = UdcComponent,, Component_Inst

[LnvAppFrmDevice_InstallWin11.NTarm64.Components]
AddComponent = UdcComponent,, Component_Inst

[Component_Inst]
ComponentIDs = UdsUdcDriverComponent

