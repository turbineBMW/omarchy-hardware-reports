[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %Elevoc%
CatalogFile = ElevocAPOARM64.cat
DriverVer   = 11/03/2025, 4.2001.6.257
PnpLockdown = 1

[Manufacturer]
%Elevoc% = ApoComponents,NTarm64.10.0,NTarm64.10.0...22621

[ApoComponents.NTarm64.10.0]
%Apo.ComponentDesc% = ApoComponent_Install,SWC\VEN_ELEVOC&AID_0002

[ApoComponents.NTarm64.10.0...22621]
%Apo.ComponentDesc% = ApoComponent_Install_win11,SWC\VEN_ELEVOC&AID_0002
%Apo.ComponentDesc% = ApoComponent_Install_Mic,SWC\VEN_ELEVOC&AID_0003
%Apo.ComponentDesc% = ApoComponent_Install_SoundWire_MicExt,SWC\VEN_ELEVOC&AID_0005
%Apo.ComponentDesc% = ApoComponent_Install_SoundWire_Sp,SWC\VEN_ELEVOC&AID_0006
%Apo.ComponentDesc% = ApoComponent_Install_SoundWire_SpEx,SWC\VEN_ELEVOC&AID_0007

[SourceDisksFiles]
elevoc_core_engine.dll=222
elevoc_engine.dll=222
elevoc_qns.dll=222
elevoc_speech_engine.dll=222
elevoc_speechtwomic.dll=222
elevoc_teamsaec.dll=222
ElevocAudioManager.exe=222
ElevocControlService.exe=222
ElevocQNNEngine.dll=222
ElevocSEEngine.dll=222
ElevocUAPO.dll=222
ElevocDAPO.dll=222
QnnHtp.dll=222
QnnSystem.dll=222
msvcp140.dll=222
vcruntime140.dll=222
vcruntime140_1.dll=222
elevoc_voice_separation.dll=222
elevoc_prompt_reboot.exe=222
settings_icon.png=222

[SourceDisksNames]
222 = %DiskId%

[DestinationDirs]
SfxFx.CopyList=11,ElevocInstallDriver ; %SystemRoot%\system32\ElevocInstallDriver
APOService.CopyList=11,ElevocInstallDriver

[ApoComponent_Install.NT]
Include   = wdmaudio.inf
Needs     = mssysfx.CopyFilesAndRegister
CopyFiles = SfxFx.CopyList
AddReg    = ElevocAPO.AddReg
CopyFiles = APOService.CopyList

[ApoComponent_Install.NT.Services]
AddService = , 0x00000002
AddService=ElevocService,0x00000800,APOService_Install

[ApoComponent_Install_win11.NT]
Include   = wdmaudio.inf
Needs     = mssysfx.CopyFilesAndRegister
CopyFiles = SfxFx.CopyList
AddReg    = ElevocAPO_win11.AddReg
CopyFiles = APOService.CopyList

[ApoComponent_Install_win11.NT.Services]
AddService = , 0x00000002
AddService=ElevocService,0x00000800,APOService_Install

[ApoComponent_Install_Mic.NT]
AddReg    = ElevocAPO_UAPO.AddReg

[ApoComponent_Install_Mic.NT.Services]
AddService = , 0x00000002

[ApoComponent_Install_SoundWire_MicExt.NT]
AddReg    = ElevocAPO_UAPO.AddReg

[ApoComponent_Install_SoundWire_MicExt.NT.Services]
AddService = , 0x00000002

[ApoComponent_Install_SoundWire_Sp.NT]
CopyFiles = SfxFx.CopyList
AddReg    = ElevocAPO_DAPO.AddReg
CopyFiles = APOService.CopyList

[ApoComponent_Install_SoundWire_Sp.NT.Services]
AddService = , 0x00000002
AddService=ElevocService,0x00000800,APOService_Install

[ApoComponent_Install_SoundWire_SpEx.NT]
AddReg    = ElevocAPO_DAPO.AddReg

[ApoComponent_Install_SoundWire_SpEx.NT.Services]
AddService = , 0x00000002

[SfxFx.CopyList]
elevoc_core_engine.dll
elevoc_engine.dll
elevoc_qns.dll
elevoc_speech_engine.dll
elevoc_speechtwomic.dll
elevoc_teamsaec.dll
ElevocAudioManager.exe
ElevocControlService.exe
ElevocQNNEngine.dll
ElevocSEEngine.dll
ElevocUAPO.dll
ElevocDAPO.dll
QnnHtp.dll
QnnSystem.dll
vcruntime140.dll
vcruntime140_1.dll
msvcp140.dll
elevoc_voice_separation.dll

[APOService.CopyList]
ElevocControlService.exe
ElevocAudioManager.exe
elevoc_prompt_reboot.exe
settings_icon.png

[APOService_Install]
DisplayName = %ServiceDisplayName%
Description = %ServiceDescription%
ServiceType=0x00000010
StartType=2
ErrorControl=1
ServiceBinary=%11%\ElevocInstallDriver\ElevocControlService.exe

