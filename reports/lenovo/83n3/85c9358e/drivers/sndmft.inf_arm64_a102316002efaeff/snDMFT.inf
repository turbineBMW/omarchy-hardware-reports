[WdmCompanionFilter_CompanionSect]
CompanionServices = SecureUSBVideo

[WdmCompanionFilter_KmdfSvcSect]
KmdfLibraryVersion = %KMDF_VERSION%

[SecureUSBVideo_UmdfSvcSect]
UmdfLibraryVersion = %UMDF_VERSION%
ServiceBinary = %12%\UMDF\SecureUSBVideo.dll
ServiceType = SecureCompanion ; allowed options are: Driver (default), SecureCompanion, NonSecureCompanion
TrustletIdentity = 4096          ; required if it is SecureCompanion


;==========================================================================
; CopyFiles
;==========================================================================
[Install_DeviceMFT.CopyFiles]
SonixDeviceMFT.dll
onnxruntime.dll
DirectML.dll
msvcp140.dll
vcruntime140.dll
vcruntime140_1.dll

;==========================================================================
; AddReg - DDInstall Section
;==========================================================================
[Install_DeviceMFT.AddReg]
HKLM,%StaticPath%,,,"Sonix DeviceMFT Class"
HKLM,%StaticPath%\InprocServer32,,%REG_EXPAND_SZ%,"%%SystemRoot%%\system32\SONiX\%DeviceMFT.CLSID%\SonixDeviceMFT.dll"
HKLM,%StaticPath%\InprocServer32,ThreadingModel,,"Both"
; RGB State
HKLM,%StaticPath%\InprocServer32,RGBStreaming,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,IRStreaming,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,IsHelloMode,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,IRMode,%REG_DWORD%,0
; For control ISP which related to DNN
HKLM,%StaticPath%\InprocServer32,GPU,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,HDR,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,FTC,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,ECCC,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,AFC,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,AFE,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,BBC,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,BBM,%REG_DWORD%,1
HKLM,%StaticPath%\InprocServer32,S2_Weight,%REG_DWORD%,160
HKLM,%StaticPath%\InprocServer32,S2_Strength,%REG_DWORD%,7
HKLM,%StaticPath%\InprocServer32,S2_EdgeDark,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,Pinterval,%REG_DWORD%,3
HKLM,%StaticPath%\InprocServer32,S2_Dedug,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,S2_RandW,%REG_DWORD%,7
HKLM,%StaticPath%\InprocServer32,EnSpecialeffect,%REG_DWORD%,1
HKLM,%StaticPath%\InprocServer32,Show_IRDiff,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,ShowROI,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,Debug_map,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,smallThr,%REG_DWORD%,50
; For workaround(Fix brightness error issue, workaround)
HKLM,%StaticPath%\InprocServer32,YTarget,%REG_DWORD%,120
; For background blur debug
;HKLM,%StaticPath%\InprocServer32,Pix_interval,%REG_DWORD%,16
;HKLM,%StaticPath%\InprocServer32,S1_Weight,%REG_DWORD%,16
; For 
HKLM,%StaticPath%\InprocServer32,SharpenMode,%REG_DWORD%,4
HKLM,%StaticPath%\InprocServer32,BlurSize,%REG_DWORD%,11
HKLM,%StaticPath%\InprocServer32,ShowMask,%REG_DWORD%,0

HKLM,%StaticPath%\InprocServer32,onlyNearest,%REG_DWORD%,1
HKLM,%StaticPath%\InprocServer32,ratioThrsh,%REG_SZ%,"0.9"

HKLM,%StaticPath%\InprocServer32,StreamRun,%REG_DWORD%,0
HKLM,%StaticPath%\InprocServer32,DriverRun,%REG_DWORD%,1

[Install_DeviceMFT.AddReg.Security]
"D:AR(A;;GA;;;BU)"

;==========================================================================
; AddReg - HW Section
;==========================================================================
[HW_EC.AddReg]
; Change device name in device manger
HKR,,FriendlyName,,%DeviceDesc_RGB_EC%
; Enable/Disable Dshow Bridgde(bit 0) & MJPG Decoder(bit 1)
; 0x00000000 : Disable Dshow Bridgde, Disable MJPG Decoder
; 0x00000001 : Enable Dshow Bridgde, Disable MJPG Decoder
; 0x00000002 : Disable Dshow Bridgde, Enable MJPG Decoder
; 0x00000003 : Enable Dshow Bridgde, Enable MJPG Decoder
HKR,,EnableDshowRedirection,%REG_DWORD%,0x00000001

[HW_IC.AddReg]
; Change device name in device manger
HKR,,FriendlyName,,%DeviceDesc_RGB_IC%
; Enable/Disable Dshow Bridgde(bit 0) & MJPG Decoder(bit 1)
; 0x00000000 : Disable Dshow Bridgde, Disable MJPG Decoder
; 0x00000001 : Enable Dshow Bridgde, Disable MJPG Decoder
; 0x00000002 : Disable Dshow Bridgde, Enable MJPG Decoder
; 0x00000003 : Enable Dshow Bridgde, Enable MJPG Decoder
HKR,,EnableDshowRedirection,%REG_DWORD%,0x00000001

[HW_IC_WA.AddReg]
; Change device name in device manger
HKR,,FriendlyName,,%DeviceDesc_RGB_IC%
; Enable/Disable Dshow Bridgde(bit 0) & MJPG Decoder(bit 1)
; 0x00000000 : Disable Dshow Bridgde, Disable MJPG Decoder
; 0x00000001 : Enable Dshow Bridgde, Disable MJPG Decoder
; 0x00000002 : Disable Dshow Bridgde, Enable MJPG Decoder
; 0x00000003 : Enable Dshow Bridgde, Enable MJPG Decoder
HKR,,EnableDshowRedirection,%REG_DWORD%,0x00000001

[HW_IR.AddReg]
; Change device name in device manger
HKR,,FriendlyName,,%DeviceDesc_IR%
HKR,,SensorCameraMode,%REG_DWORD%,0x00000001
HKR,,SkipCameraEnumeration,%REG_DWORD%,0x00000001
; Enable/Disable Dshow Bridgde(bit 0) & MJPG Decoder(bit 1)
; 0x00000000 : Disable Dshow Bridgde, Disable MJPG Decoder
; 0x00000001 : Enable Dshow Bridgde, Disable MJPG Decoder
; 0x00000002 : Disable Dshow Bridgde, Enable MJPG Decoder
; 0x00000003 : Enable Dshow Bridgde, Enable MJPG Decoder
HKR,,EnableDshowRedirection,%REG_DWORD%,0x00000001

