DriverVer = 11/10/2024,1.0.2.64
CatalogFile = ElevocEffectsPackBTExt_ARM.cat
PnpLockDown = 1

[Manufacturer]
%ManufacturerName% = DeviceExtensions,NTARM64.10.0...22621

[DeviceExtensions.NTARM64.10.0...22621]
;S790 WOA
%Device.ExtensionDesc% = ThreePointFive_BT,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_IDEA4001
%Device.ExtensionDesc% = ThreePointFive_BT,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_IDEA4002
;S3 WOA
%Device.ExtensionDesc% = ThreePointFive_BT,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_380317AA

[ThreePointFive_BT.NT]

[ThreePointFive_BT.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,  %KSNAME_TopologyBthHfpMic%, Elevoc_Install_BT
AddInterface=%KSCATEGORY_TOPOLOGY%,  %KSNAME_TopologyBthHfpMic%, Elevoc_Install_BT

[Elevoc_Install_BT]
AddReg = APOFX_AddReg_BT

[APOFX_AddReg_BT]
HKR,FX\0,%PKEY_SYSFX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0,%PKEY_FX_ModeEffectClsid%,%REG_SZ%,%ELEVOC_UAPO_CLSID%
HKR,FX\0,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_SPEECH%,%AUDIO_SIGNALPROCESSINGMODE_RAW%
HKR,FX\0,%PKEY_Effect_Enable%,%REG_DWORD%,1

[ThreePointFive_BT.NT.Components]
AddComponent = ElevocAPO,,ElevocAPO_Install

[ElevocAPO_Install]
ComponentIDs = SWC\VEN_ELEVOC&AID_0002
Description = "Elevoc Audio Effects Component"

[SourceDisksNames]
222 = %DiskId%

[SourceDisksFiles]

[DestinationDirs]
DefaultDestDir = 13  ; copy to driverstore

