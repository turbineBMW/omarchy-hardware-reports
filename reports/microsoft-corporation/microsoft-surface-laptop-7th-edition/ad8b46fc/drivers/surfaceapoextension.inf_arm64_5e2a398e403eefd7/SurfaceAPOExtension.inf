;===================================================================
[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId = {06FF0735-E049-447F-B701-879A3DE533C4}
Provider    = %SURFACE_APO_ProviderName%
DriverVer = 06/28/2024,1.216.42.0
CatalogFile = SurfaceAPOExtension.cat
PnpLockDown = 1

[SourceDisksNames]
1 = Disk

[SourceDisksFiles]
SurfaceAPO_0A.json = 1
SurfaceAPO_0B.json = 1
SurfaceAPO_0C.json = 1
SurfaceAPO_0D.json = 1

[DestinationDirs]
Config_CopyFiles = 13 ; Driver Package's DriverStore Directory

[Manufacturer]
%SURFACE_APO_MfgName% = DeviceExtensions,NTARM64.10.0...19041

[DeviceExtensions.NTARM64.10.0...19041]
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_0A,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_MSHW0462&REV_0A
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_0B,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_MSHW0462&REV_0B
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_0C,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_MSHW0486&REV_0C
%Device.ExtensionDesc% = DeviceExtension_Install_Surface_0D,AUCD\VEN_QCOM&DEV_0C29&SUBSYS_MSHW0486&REV_0D

[DeviceExtension_Install_Surface_0A.NT]
CopyFiles = Config_CopyFiles

[DeviceExtension_Install_Surface_0B.NT]
CopyFiles = Config_CopyFiles

[DeviceExtension_Install_Surface_0C.NT]
CopyFiles = Config_CopyFiles

[DeviceExtension_Install_Surface_0D.NT]
CopyFiles = Config_CopyFiles

[DeviceExtension_Install_Surface_0A.NT.Components]
AddComponent = SurfaceApo,,SurfaceApo_AddComponent

[DeviceExtension_Install_Surface_0B.NT.Components]
AddComponent = SurfaceApo,,SurfaceApo_AddComponent

[DeviceExtension_Install_Surface_0C.NT.Components]
AddComponent = SurfaceApo,,SurfaceApo_AddComponent

[DeviceExtension_Install_Surface_0D.NT.Components]
AddComponent = SurfaceApo,,SurfaceApo_AddComponent

[DeviceExtension_Install_Surface_0A.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0A
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0A
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0A
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0A
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0A

[DeviceExtension_Install_Surface_0B.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0B
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0B
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0B
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0B
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0B

[DeviceExtension_Install_Surface_0C.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0C
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0C
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0C
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0C
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0C

[DeviceExtension_Install_Surface_0D.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0D
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0D
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, SurfaceAPO_Install_0D
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0D
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, SurfaceAPO_Install_0D

;======================================================
; APO per-interface registry
;======================================================
[SurfaceAPO_Install_0A]
AddReg = APO.I.Association0.AddReg_Common,APO.I.Association0.AddReg_0A

[SurfaceAPO_Install_0B]
AddReg = APO.I.Association0.AddReg_Common,APO.I.Association0.AddReg_0B

[SurfaceAPO_Install_0C]
AddReg = APO.I.Association0.AddReg_Common,APO.I.Association0.AddReg_0C

[SurfaceAPO_Install_0D]
AddReg = APO.I.Association0.AddReg_Common,APO.I.Association0.AddReg_0D

[APO.I.Association0.AddReg_0A]
HKR,FX\0\%SURFACE_APO_CONTEXT%\Default,%PKEY_SurfaceApoConfigFilename%,%REG_SZ%,%13%\SurfaceAPO_0A.json

[APO.I.Association0.AddReg_0B]
HKR,FX\0\%SURFACE_APO_CONTEXT%\Default,%PKEY_SurfaceApoConfigFilename%,%REG_SZ%,%13%\SurfaceAPO_0B.json

[APO.I.Association0.AddReg_0C]
HKR,FX\0\%SURFACE_APO_CONTEXT%\Default,%PKEY_SurfaceApoConfigFilename%,%REG_SZ%,%13%\SurfaceAPO_0C.json

[APO.I.Association0.AddReg_0D]
HKR,FX\0\%SURFACE_APO_CONTEXT%\Default,%PKEY_SurfaceApoConfigFilename%,%REG_SZ%,%13%\SurfaceAPO_0D.json

[APO.I.Association0.AddReg_Common]
; for installing on QC
HKR,FX\0\%SURFACE_APO_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%SURFACE_APO_CONTEXT%\User,%PKEY_SurfaceApoEnableMteMode%,%REG_DWORD%,0

; Set SAF proxy settings
; No SAF proxy for this product configuration

[Config_CopyFiles]
SurfaceAPO_0A.json
SurfaceAPO_0B.json
SurfaceAPO_0C.json
SurfaceAPO_0D.json

[SurfaceApo_AddComponent]
ComponentIds = VEN_MSFT&PID_SURFACEAPO ; HWID: SWC\VEN_MSFT&PID_SURFACEAPO

