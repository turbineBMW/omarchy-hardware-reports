[Version]
Signature="$Windows NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider=%ManufacturerName%
CatalogFile=SurfaceOemPanelCustomization.cat
ExtensionId = {C7A8D5F7-1C60-4703-9FDF-454CC9F7D945}
DriverVer = 04/25/2024,9.5.3.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=SurfaceOemPanelCustomization,NTARM64.10.0...19041

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SurfacesRGB.icm = 1
SurfaceVivid.icm = 1
SurfaceHDR.icm = 1
PQConfig.dv = 1
DisplayCalibrationConfigIncell13.bin = 1
DisplayCalibrationMeasurementsIncell13.bin = 1
DisplayCalibrationConfigOutcell13.bin = 1
DisplayCalibrationMeasurementsOutcell13.bin = 1
DisplayCalibrationConfigOutcell15.bin = 1
DisplayCalibrationMeasurementsOutcell15.bin = 1


[DestinationDirs]
;23 == Windows\system32\spool\drivers\color
;13 == driverstore
ProfilesCopy=23
CalibrationCopySHP1572=13
CalibrationCopySHP1577=13
CalibrationCopyLGD0780=13

[SurfaceOemPanelCustomization.NTARM64.10.0...19041]
%DeviceName%=SurfaceOemPanelCustomization_Install_SHP1572, Monitor\SHP1572	; _660_ROS Outcell 13"
%DeviceName%=SurfaceOemPanelCustomization_Install_SHP1577, Monitor\SHP1577	; _660_ROS Outcell 15"
%DeviceName%=SurfaceOemPanelCustomization_Install_LGD0780, Monitor\LGD0780	; _660_ROS Incell 13"

; =================== Monitor\SHP1572 ==============================
[SurfaceOemPanelCustomization_Install_SHP1572.NT]
DelReg = DEL_CURRENT_REG
CopyFiles=ProfilesCopy, CalibrationCopySHP1572
AddReg=SurfaceOemPanelCustomization_Install_NT_AddReg_SHP1572

[SurfaceOemPanelCustomization_Install_SHP1572.NT.Components]
AddComponent = Vision_SoftwareComponent,, Vision_SoftwareComponent_Inst

[CalibrationCopySHP1572]
DisplayCalibrationMeasurementsOutcell13.bin
DisplayCalibrationConfigOutcell13.bin

[SurfaceOemPanelCustomization_Install_NT_AddReg_SHP1572]
HKR,,ICMProfile,0x00010000,"SurfacesRGB.icm"
HKR,,ICMProfile,0x00010008,"SurfaceVivid.icm"
HKR,,ICMProfileAC,0x00010000,"SurfaceHDR.icm"
HKR,,CalibrationMeasurementTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationMeasurementsOutcell13.bin"
HKR,,CalibrationConfigTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationConfigOutcell13.bin"
HKR,,EnableBoostRefreshRateByDefault,%REG_DWORD%,1
HKR,,MicrosoftApprovedAcmSupport,%REG_DWORD%,1
HKR,,EnableIntegratedPanelHdrByDefault,%REG_DWORD%,0
; DOLBY Vision HDR certification GUID below
HKR,,DisplayHdrLevel,0x00010008,6363AA90-A651-4154-A9E1-2D765C08E68F

[SurfaceOemPanelCustomization_Install_SHP1572.NT.HW]
;

; =================== Monitor\SHP1577 ==============================
[SurfaceOemPanelCustomization_Install_SHP1577.NT]
DelReg = DEL_CURRENT_REG
CopyFiles=ProfilesCopy, CalibrationCopySHP1577
AddReg=SurfaceOemPanelCustomization_Install_NT_AddReg_SHP1577

[SurfaceOemPanelCustomization_Install_SHP1577.NT.Components]
AddComponent = Vision_SoftwareComponent,, Vision_SoftwareComponent_Inst

[CalibrationCopySHP1577]
DisplayCalibrationMeasurementsOutcell15.bin
DisplayCalibrationConfigOutcell15.bin

[SurfaceOemPanelCustomization_Install_NT_AddReg_SHP1577]
HKR,,ICMProfile,0x00010000,"SurfacesRGB.icm"
HKR,,ICMProfile,0x00010008,"SurfaceVivid.icm"
HKR,,ICMProfileAC,0x00010000,"SurfaceHDR.icm"
HKR,,CalibrationMeasurementTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationMeasurementsOutcell15.bin"
HKR,,CalibrationConfigTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationConfigOutcell15.bin"
HKR,,EnableBoostRefreshRateByDefault,%REG_DWORD%,1
HKR,,MicrosoftApprovedAcmSupport,%REG_DWORD%,1
HKR,,EnableIntegratedPanelHdrByDefault,%REG_DWORD%,0
; DOLBY Vision HDR certification GUID below
HKR,,DisplayHdrLevel,0x00010008,6363AA90-A651-4154-A9E1-2D765C08E68F

[SurfaceOemPanelCustomization_Install_SHP1577.NT.HW]
;

; =================== Monitor\LGD0780 ==============================
[SurfaceOemPanelCustomization_Install_LGD0780.NT]
DelReg = DEL_CURRENT_REG
CopyFiles=ProfilesCopy, CalibrationCopyLGD0780
AddReg=SurfaceOemPanelCustomization_Install_NT_AddReg_LGD0780

[SurfaceOemPanelCustomization_Install_LGD0780.NT.Components]
AddComponent = Vision_SoftwareComponent,, Vision_SoftwareComponent_Inst

[CalibrationCopyLGD0780]
DisplayCalibrationMeasurementsIncell13.bin
DisplayCalibrationConfigIncell13.bin

[SurfaceOemPanelCustomization_Install_NT_AddReg_LGD0780]
HKR,,ICMProfile,0x00010000,"SurfacesRGB.icm"
HKR,,ICMProfile,0x00010008,"SurfaceVivid.icm"
HKR,,ICMProfileAC,0x00010000,"SurfaceHDR.icm"
HKR,,CalibrationMeasurementTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationMeasurementsIncell13.bin"
HKR,,CalibrationConfigTypicalBlobFile, REG_EXPAND_SZ, "%13%\DisplayCalibrationConfigIncell13.bin"
HKR,,EnableBoostRefreshRateByDefault,%REG_DWORD%,1
HKR,,MicrosoftApprovedAcmSupport,%REG_DWORD%,1
HKR,,EnableIntegratedPanelHdrByDefault,%REG_DWORD%,0
; DOLBY Vision HDR certification GUID below
HKR,,DisplayHdrLevel,0x00010008,6363AA90-A651-4154-A9E1-2D765C08E68F

[SurfaceOemPanelCustomization_Install_LGD0780.NT.HW]
;

; =================== Generic ==================================

[Vision_SoftwareComponent_Inst]
ComponentIDs = VEN_DOLBY&PID_HSA_DolbyVisionExt

[ProfilesCopy]
SurfacesRGB.icm
SurfaceVivid.icm
SurfaceHDR.icm
PQConfig.dv

[DEL_CURRENT_REG]
HKR,,ICMProfile

[Strings]
ManufacturerName="Surface"
DeviceName="Surface Panel"
DiskName="Surface Panel Driver Customization Installation Disk"
REG_EXPAND_SZ          = 0x00020000
REG_DWORD              = 0x00010001
REG_MULTI_SZ           = 0x00010000
REG_BINARY             = 0x00000001
REG_SZ                 = 0x00000000
