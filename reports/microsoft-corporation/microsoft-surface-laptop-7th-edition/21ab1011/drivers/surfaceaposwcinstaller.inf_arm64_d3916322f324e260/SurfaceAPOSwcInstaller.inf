[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %SURFACE_APO_ProviderName%
DriverVer = 06/28/2024,1.216.42.0
CatalogFile = SurfaceAPOSwcInstaller.cat
PnpLockDown = 1

[SourceDisksNames]
1 = Disk

[SourceDisksFiles]
SurfaceAPO.dll  = 1
NOTICE.txt            = 1

[DestinationDirs]
Apo_CopyFiles = 13 ; Driver Package's DriverStore Directory

[Manufacturer]
%SURFACE_APO_MfgName% = DeviceExtensions,NTARM64.10.0...19041,NTARM64.10.0...22000

[DeviceExtensions.NTARM64.10.0...19041]
%Device.ExtensionDesc% = SurfaceAPO_SWC_Install_Win10,SWC\VEN_MSFT&PID_SURFACEAPO

[DeviceExtensions.NTARM64.10.0...22000]
%Device.ExtensionDesc% = SurfaceAPO_SWC_Install_Win11,SWC\VEN_MSFT&PID_SURFACEAPO

[SurfaceAPO_SWC_Install_Win10.NT]
CopyFiles = Apo_CopyFiles
AddReg = Apo_AddReg_Win10

[SurfaceAPO_SWC_Install_Win11.NT]
CopyFiles = Apo_CopyFiles
AddReg = Apo_AddReg_Win11

[SurfaceAPO_SWC_Install_Win10.NT.Services]
AddService = ,0x00000002 ; NULL service for APO

[SurfaceAPO_SWC_Install_Win11.NT.Services]
AddService = ,0x00000002 ; NULL service for APO

[Apo_CopyFiles]
SurfaceAPO.dll
NOTICE.txt

[Apo_AddReg_Win10]
; MFX CLSID registration
HKCR,CLSID\%SURFACE_RENDER_MFX_CLSID%,,,%SURFACE_RENDER_MFX_FriendlyName%
HKCR,CLSID\%SURFACE_RENDER_MFX_CLSID%\InProcServer32,,%REG_SZ%,%13%\SurfaceAPO.dll
HKCR,CLSID\%SURFACE_RENDER_MFX_CLSID%\InProcServer32,ThreadingModel,,"Both"

; EFX CLSID registration
HKCR,CLSID\%SURFACE_RENDER_EFX_CLSID%,,,%SURFACE_RENDER_EFX_FriendlyName%
HKCR,CLSID\%SURFACE_RENDER_EFX_CLSID%\InProcServer32,,%REG_SZ%,%13%\SurfaceAPO.dll
HKCR,CLSID\%SURFACE_RENDER_EFX_CLSID%\InProcServer32,ThreadingModel,,"Both"

; SFX CLSID registration
HKCR,CLSID\%SURFACE_CAPTURE_SFX_CLSID%,,,%SURFACE_CAPTURE_SFX_FriendlyName%
HKCR,CLSID\%SURFACE_CAPTURE_SFX_CLSID%\InProcServer32,,%REG_SZ%,%13%\SurfaceAPO.dll
HKCR,CLSID\%SURFACE_CAPTURE_SFX_CLSID%\InProcServer32,ThreadingModel,,"Both"

; APO properties registration
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"FriendlyName",,%SURFACE_RENDER_MFX_FriendlyName%
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"Copyright",,%SURFACE_APO_Copyright%
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MajorVersion",%REG_DWORD%,1
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MinorVersion",%REG_DWORD%,0
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"Flags",%REG_DWORD%,%APO_FLAG_DEFAULT%
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MinInputConnections",%REG_DWORD%,1
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MaxInputConnections",%REG_DWORD%,1
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MinOutputConnections",%REG_DWORD%,1
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MaxOutputConnections",%REG_DWORD%,1
HKCR,AudioEngine\AudioProcessingObjects\%SURFACE_RENDER_MFX_CLSID%,"MaxInstances",%REG_DWORD%,0xffffffff
