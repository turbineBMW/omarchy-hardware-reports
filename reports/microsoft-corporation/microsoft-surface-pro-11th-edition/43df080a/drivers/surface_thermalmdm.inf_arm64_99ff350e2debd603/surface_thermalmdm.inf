;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[Version]
Signature="$WINDOWS NT$"
Class=SYSTEM
ClassGUID={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=surface_thermalmdm.cat
DriverVer = 02/13/2024,1.0.184.0
PnpLockdown=1


[DestinationDirs]
DefaultDestDir = 13
ThermalMDM_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
qcthermalmdm.sys  = 1,,
;


;*****************************************
; Install Section
;*****************************************


[Manufacturer]
%ManufacturerName%=Standard,NTARM64.10.0...19041


[Standard.NTARM64.10.0...19041]
;Sensor Devices
%ThermalMDM_TS1.DeviceDesc%=ThermalMDM_TS1, ACPI\OEM2UPDX65TS01
%ThermalMDM_TS2.DeviceDesc%=ThermalMDM_TS2, ACPI\OEM2UPX65TS02
%ThermalMDM_TS3.DeviceDesc%=ThermalMDM_TS3, ACPI\OEM2UPDX65TS03
%ThermalMDM_TS4.DeviceDesc%=ThermalMDM_TS4, ACPI\OEM2UPDX65TS04
%ThermalMDM_TS5.DeviceDesc%=ThermalMDM_TS5, ACPI\OEM2UPDX65TS05
%ThermalMDM_TS6.DeviceDesc%=ThermalMDM_TS6, ACPI\OEM2UPDX65TS06
%ThermalMDM_TS7.DeviceDesc%=ThermalMDM_TS7, ACPI\OEM2UPDX65TS07
%ThermalMDM_TS8.DeviceDesc%=ThermalMDM_TS8, ACPI\OEM2UPDX65TS08
%ThermalMDM_TS9.DeviceDesc%=ThermalMDM_TS9, ACPI\OEM2UPDX65TS09
%ThermalMDM_TS10.DeviceDesc%=ThermalMDM_TS10, ACPI\OEM2UPDX65TS10
%ThermalMDM_TS11.DeviceDesc%=ThermalMDM_TS11, ACPI\OEM2UPDX65TS11
%ThermalMDM_TS12.DeviceDesc%=ThermalMDM_TS12, ACPI\OEM2UPDX65TS12
%ThermalMDM_TS13.DeviceDesc%=ThermalMDM_TS13, ACPI\OEM2UPDX65TS13
%ThermalMDM_TS14.DeviceDesc%=ThermalMDM_TS14, ACPI\OEM2UPDX65TS14
%ThermalMDM_TS15.DeviceDesc%=ThermalMDM_TS15, ACPI\OEM2UPDX65TS15

;Mitigation Devices
%ThermalMDM_MPA.DeviceDesc%=ThermalMDM_MPA, ACPI\OEM2UPDX65MPA
%ThermalMDM_MPA1.DeviceDesc%=ThermalMDM_MPA1, ACPI\OEM2UPDX65MPA1
%ThermalMDM_MBJ0.DeviceDesc%=ThermalMDM_MBJ0, ACPI\OEM2UPDX65MBJ0
%ThermalMDM_MBJ1.DeviceDesc%=ThermalMDM_MBJ1, ACPI\OEM2UPDX65MBJ1
%ThermalMDM_MBJ2.DeviceDesc%=ThermalMDM_MBJ2, ACPI\OEM2UPDX65MBJ2
%ThermalMDM_MBJ3.DeviceDesc%=ThermalMDM_MBJ3, ACPI\OEM2UPDX65MBJ3
%ThermalMDM_MBS0.DeviceDesc%=ThermalMDM_MBS0, ACPI\OEM2UPDX65MBS0
%ThermalMDM_MBS1.DeviceDesc%=ThermalMDM_MBS1, ACPI\OEM2UPDX65MBS1
%ThermalMDM_MBS2.DeviceDesc%=ThermalMDM_MBS2, ACPI\OEM2UPDX65MBS2
%ThermalMDM_MBS3.DeviceDesc%=ThermalMDM_MBS3, ACPI\OEM2UPDX65MBS3
%ThermalMDM_MSKN.DeviceDesc%=ThermalMDM_MSKN, ACPI\OEM2UPDX65MSKN
%ThermalMDM_MJCT.DeviceDesc%=ThermalMDM_MJCT, ACPI\OEM2UPDX65MJCT
%ThermalMDM_MBCL.DeviceDesc%=ThermalMDM_MBCL, ACPI\OEM2UPDX65MBCL
%ThermalMDM_M4G.DeviceDesc%=ThermalMDM_M4G, ACPI\OEM2UPDX65M4G
%ThermalMDM_M5G.DeviceDesc%=ThermalMDM_M5G, ACPI\OEM2UPDX65M5G
%ThermalMDM_M5GSCG.DeviceDesc%=ThermalMDM_M5GSCG, ACPI\OEM2UPDX65M5GSCG

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;TS1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;-------------- Registry Definition
[ThermalMDM_TS1.NT]
CopyFiles=Drivers_Dir
AddReg= ThermalMDM_Reg_TS1

[ThermalMDM_Reg_TS1]
HKR,,"DeviceType",%REG_DWORD%,"1"
HKR,,"QMIDeviceName",%REG_SZ%,"pa"

;-------------- Installation
[ThermalMDM_TS1.NT.Services]
AddService = qcthermalmdm,%SPSVCINST_ASSOCSERVICE%, ThermalMDM_Service_Inst

[ThermalMDM_TS1.NT.CoInstallers]
AddReg=ThermalMDM_Device_CoInstaller_AddReg
CopyFiles=ThermalMDM_Device_CoInstaller_CopyFiles

;-------------- Wdf
[ThermalMDM_TS1.NT.Wdf]
KmdfService =  qcthermalmdm, ThermalMDM_wdfsect
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;TS1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;MPA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;-------------- Registry Definition
[ThermalMDM_MPA.NT]
CopyFiles=Drivers_Dir
AddReg= ThermalMDM_Reg_MPA

[ThermalMDM_Reg_MPA]
HKR,,"DeviceType",%REG_DWORD%,"2"
;MapTable--Mappings for Mitigation device from performance percentage to thermal mitigation level
HKR,,"MapTable",%REG_BINARY%,0x21,0xFF,0x42,0x0C,0x63,0x05,0x64,0x00
;           Percent(<=), TM level,
;           -----        ----------
;            Package () { 33,          255 },
;            Package () { 66,          12 },
;            Package () { 99,          5 },
;            Package () { 100,         0 }
HKR,,"QMIDeviceName",%REG_SZ%,"pa_lte_sdr0_dsc"

;-------------- Installation
[ThermalMDM_MPA.NT.Services]
AddService = qcthermalmdm,%SPSVCINST_ASSOCSERVICE%, ThermalMDM_Service_Inst

[ThermalMDM_MPA.NT.CoInstallers]
AddReg=ThermalMDM_Device_CoInstaller_AddReg
CopyFiles=ThermalMDM_Device_CoInstaller_CopyFiles

;-------------- Wdf
[ThermalMDM_MPA.NT.Wdf]
KmdfService =  qcthermalmdm, ThermalMDM_wdfsect
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;MPA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

