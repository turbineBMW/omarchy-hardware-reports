[QCDX_Inst_Ext_8380_IDP.NT]
CopyFiles = QCDX.Files.NTarm_13_IDP
AddReg    = QCDX_8380_AcpiConfigExtIdp, QCDX_8380_PanelcfgOverridesIdp

[QCDX_Inst_Ext_8380_CRD.NT]
CopyFiles = QCDX.Files.NTarm_13_CRD
AddReg    = QCDX_8380_AcpiConfigExtCrd, QCDX_8380_PanelcfgOverridesCrd

[QCDX.Files.NTarm_13_IDP]
qcdxkmext8380_DENidp.bin

[QCDX.Files.NTarm_13_CRD]
qcdxkmext8380_DENcrd.bin

[QCDX_8380_AcpiConfigExtIdp]
HKR, , AcpiExtFile, %REG_SZ%, %13%\qcdxkmext8380_DENidp.bin
HKR, DISPLAY, DisableMDPBLT, %REG_DWORD%, 1
HKR, DISPLAY, DisableRotator, %REG_DWORD%, 0
HKR, DISPLAY, DisableExternal, %REG_DWORD%, 0

[QCDX_8380_AcpiConfigExtCrd]
HKR, , AcpiExtFile, %REG_SZ%, %13%\qcdxkmext8380_DENcrd.bin
HKR, DISPLAY, DisableMDPBLT, %REG_DWORD%, 1
HKR, DISPLAY, DisableRotator, %REG_DWORD%, 0
HKR, DISPLAY, DisableExternal, %REG_DWORD%, 0

[QCDX_8380_PanelcfgOverridesIdp]
HKR, Miniport\DISPLAY\Config, PanelCfg1BrightnessMinLuminance, %REG_DWORD%, 2000
HKR, Miniport\DISPLAY\Config, PanelCfg1BrightnessMaxLuminance, %REG_DWORD%, 600000

[QCDX_8380_PanelcfgOverridesCrd]
HKR, Miniport\DISPLAY\Config, PanelCfg1BrightnessMinLuminance, %REG_DWORD%, 2000
HKR, Miniport\DISPLAY\Config, PanelCfg1BrightnessMaxLuminance, %REG_DWORD%, 900000

