[Version]
Signature="$Windows NT$"
Class=Firmware
ClassGuid={f2e7dd72-6468-4e36-b6f1-6488f42c1b52}
Provider=%ManufacturerName%
CatalogFile=SurfaceStorageFwUpdateMZ9L4512HBLU00BMVPackage.cat
DriverVer = 07/19/2024,1.12.9.0
PnPLockDown=1

[SourceDisksNames]
1= %DiskName%

[DestinationDirs]
StorFwUpdateSurface.CopyFiles=13

[Manufacturer]
%ManufacturerName%=Standard,NTARM64.10.0...19041

[Standard.NTARM64.10.0...19041]
%StorFwUpdateSurface.DeviceDesc%=StorFwUpdateSurface, SWC\StorageFwUpdate_MZ9L4512HBLU_00B_

[StorFwUpdateSurface.NT]
Include            = StorFwUpdate.inf
Needs              = StorFwUpdate.NT
CopyFiles          = StorFwUpdateSurface.CopyFiles

[StorFwUpdateSurface.NT.Wdf]
Include            = StorFwUpdate.inf
Needs              = StorFwUpdate.NT.Wdf

[StorFwUpdateSurface.NT.HW]
AddReg = StorFwUpdateSurface_HWAddReg

[StorFwUpdateSurface_HWAddReg]
HKR,,FriendlyName,,%FwUpdateFriendlyName%

; Specify the location of the firmware offer and payload file in the registry.
; The files are kept in driver store. When deployed, %13% would be expanded to the actual path
; in driver store.
;
HKR,0D9EB3D6-6F14-4E8A-811B-F3B19F7ED98A\0,FirmwareImageVersion, 0x00000000, "HXC75M0Q"
HKR,0D9EB3D6-6F14-4E8A-811B-F3B19F7ED98A\0,FirmwareFileName, 0x00000000, %13%\HXC75M0Q_noFormat.bin

[SourceDisksFiles]
HXC75M0Q_noFormat.bin=1

[StorFwUpdateSurface.CopyFiles]
HXC75M0Q_noFormat.bin

[StorFwUpdateSurface.NT.Services]
Include            = StorFwUpdate.inf
Needs              = StorFwUpdate.NT.Services

; =================== Generic ==================================

[Strings]
ManufacturerName="Surface"
StorFwUpdateSurface.DeviceDesc = "Storage Firmware Update Samsung MZ9L4512HBLU-00BMV"
DiskName = "Storage Firmware Update Installation Disk"
FwUpdateFriendlyName= "Samsung NVME MZ9L4512HBLU-00BMV PM9B1 Storage Firmware Update"
