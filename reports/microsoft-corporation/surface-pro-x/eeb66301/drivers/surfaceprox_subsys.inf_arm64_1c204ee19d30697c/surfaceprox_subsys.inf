[Version]
Signature="$WINDOWS NT$"
Class=SYSTEM
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%SURFACE%
DriverVer = 04/25/2023,1.0.1960.1
CatalogFile=SurfaceProX_subsys.cat
PnpLockDown=1

[DestinationDirs]
Drivers_Dir = 13

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]
qcsubsys8180.sys = 1

[ControlFlags]
ExcludeFromSelect = *

;*****************************************
; Subsystem Driver Install Section
;*****************************************

[Manufacturer]
%SURFACE%=Standard,NTARM64

[WDTFSOCDeviceCategory]
{5D078032-6378-437B-8DA5-9B32B7CA3FDD},2,7,,2

[Standard.NTARM64]
%ADSP.DeviceDesc%=SUBSYS_Device_ADSP, ACPI\QCOM041D
%SERVICEMANAGER.DeviceDesc%=SUBSYS_Device, ACPI\QCOM0420
%TEST.DeviceDesc%=SUBSYS_Device, ADSP\DEADCODE
%TEST.DeviceDesc%=SUBSYS_Device, QCMS\DEADCODE
%SSDD.DeviceDesc%=SUBSYS_Device, ACPI\QCOM0422
%CDSP.DeviceDesc%=SUBSYS_Device, ACPI\QCOM0423
%SPSS.DeviceDesc%=SUBSYS_Device, ACPI\QCOM0499

;Modem Configurations
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTP08180
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CDP08180
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLS08180
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM_E, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPE8180
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM_E, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLSE8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_APQ_A, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPA8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_APQ_A, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CDPA8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_APQ_A, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLSA8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_B, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPB8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_B, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLSB8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_C, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPC8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_C, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLSC8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_B, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPD8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_D, ACPI\VEN_QCOM&DEV_041E&SUBSYS_CLSD8180
%AMSS_NM.DeviceDesc%=SUBSYS_Device_AMSS_F, ACPI\VEN_QCOM&DEV_041E&SUBSYS_MTPF8180
%AMSS.DeviceDesc%=SUBSYS_Device_AMSS_MSM, ACPI\QCOM041E

%AMSSMPThermal.DeviceDesc%=SUBSYS_Device_AMSS_MPTM, ACPI\QCOM04AF

;Sensors Configurations
%SCSS.DeviceDesc%=SUBSYS_Device_SCSS, ACPI\QCOM0421


[SUBSYS_Device.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg

[SUBSYS_Device.NT.HW]
AddReg=SUBSYSACL 

[SUBSYS_Device_ADSP.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg

[SUBSYS_Device_ADSP.NT.HW]
AddReg=SUBSYSACL, ADSP_Children, ADSP_PDInfo 

; This installs sensors for all default platforms other than CLS
[SUBSYS_Device_SCSS.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_SCSS

[SUBSYS_Device_SCSS.NT.HW]
AddReg=SUBSYSACL

;-------------- Service installation
[SUBSYS_Device.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_SCSS.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_ADSP.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_MSM.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_MSM

[SUBSYS_Device_AMSS_MSM.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_MSM, WLAN_Hashmapping, AMSS_PDInfo

[SUBSYS_Device_AMSS_MSM_E.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_MSM_E

[SUBSYS_Device_AMSS_MSM_E.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_MSM_E, WLAN_Hashmapping, AMSS_PDInfo_E

[SUBSYS_Device_AMSS_APQ_A.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_APQ_A

[SUBSYS_Device_AMSS_APQ_A.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_APQ_A, WLAN_Hashmapping, AMSS_PDInfo

[SUBSYS_Device_AMSS_B.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_B

[SUBSYS_Device_AMSS_B.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_B, WLAN_Hashmapping, AMSS_PDInfo

[SUBSYS_Device_AMSS_C.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_C

[SUBSYS_Device_AMSS_C.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_C, WLAN_Hashmapping, AMSS_PDInfo_C

[SUBSYS_Device_AMSS_D.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_D

[SUBSYS_Device_AMSS_D.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_D, WLAN_Hashmapping, AMSS_PDInfo_D

[SUBSYS_Device_AMSS_F.NT]
CopyFiles=Drivers_Dir
AddProperty=WDTFSOCDeviceCategory
AddReg=SUBSYSReg_AMSS_COMMON,SUBSYSReg_AMSS_F

[SUBSYS_Device_AMSS_F.NT.HW]
AddReg=SUBSYSACL, AMSS_Children_F, WLAN_Hashmapping, AMSS_PDInfo_F

[SUBSYS_Device_AMSS_MPTM.NT]
AddReg=SUBSYSReg_AMSS_MPTM

[SUBSYS_Device_AMSS_MPTM.NT.HW]
AddReg=SUBSYSACL

;-------------- Service installation
[SUBSYS_Device_AMSS_MSM.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_MSM_E.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_APQ_A.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_B.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_C.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_D.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_F.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYS_Device_AMSS_MPTM.NT.Services]
AddService = qcsubsys,%SPSVCINST_ASSOCSERVICE%, SUBSYS_Service_Inst

[SUBSYSACL]
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;S-1-5-84-0-0-0-0-0)" 

