[Version]
Signature="$WINDOWS NT$"
Class=Firmware
ClassGuid={f2e7dd72-6468-4e36-b6f1-6488f42c1b52}
Provider=%Provider%
DriverVer=05/22/2020,11.2.0.1
PnpLockdown=1
CatalogFile=Surface_SMF.cat

[Manufacturer]
%MfgName% = Firmware,NTARM64

[Firmware.NTARM64]
%FirmwareDesc% = Firmware_Install,UEFI\RES_{bf5b144b-15f9-4d48-9d16-321863d6ade7}

[Firmware_Install.NT]
CopyFiles = Firmware_CopyFiles

[Firmware_CopyFiles]
Smf_11.2.0.1.bin

[Firmware_Install.NT.Hw]
AddReg = Firmware_AddReg

[Firmware_AddReg]
HKR,,FirmwareId,,{bf5b144b-15f9-4d48-9d16-321863d6ade7}
HKR,,FirmwareVersion,%REG_DWORD%,0xB020001
HKR,,FirmwareFilename,,Smf_11.2.0.1.bin

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
Smf_11.2.0.1.bin = 1

[DestinationDirs]
DefaultDestDir = %DIRID_WINDOWS%,Firmware ; %SystemRoot%\Firmware

[Strings]
; localizable
Provider     = "Surface"
MfgName      = "Microsoft Corporation"
FirmwareDesc = "Surface SMF"
DiskName     = "Firmware Update"

; non-localizable
DIRID_WINDOWS = 10
REG_DWORD     = 0x00010001
