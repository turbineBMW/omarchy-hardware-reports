HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-05A5-4CDA-ABD5-C9992404DA3A},AutoName,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A5-4CDA-ABD5-C9992404DA3A},BiometricType,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A5-4CDA-ABD5-C9992404DA3A},Attributes,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A5-4CDA-ABD5-C9992404DA3A},Format,,"3B2F61F2-D8DF-40AF-B5A0-DDC0A6BCF589"
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{01BE2559-E5A5-4CDA-ABD5-C9992404DA3A},InitialSize,0x00010001,0x00000020
