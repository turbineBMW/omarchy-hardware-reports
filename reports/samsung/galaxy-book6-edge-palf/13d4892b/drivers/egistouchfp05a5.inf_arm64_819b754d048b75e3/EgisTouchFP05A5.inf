[ContactSensor_AddReg]
HKR,EgisTouchFP05A5,"MESSAGE_LEVEL",0x00010001,0x01

[ContactSensor_AddReg.security]
"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GAKA;;;WD)"

[LayoutAddReg]
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A5,location,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A5,powerbutton,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Service Providers\Fingerprint\Sensor Layout\USB VID_1C7A&PID_05A5,shape,0x00010001,0x00000002

[EventLog_ServiceInstall]
DisplayName     = "EgisTec event log service"
ServiceType     = 0x10
StartType       = 2
ErrorControl    = 1
ServiceBinary   = "%11%\Rundll32.exe %12%\UMDF\EgisTouchFPEventLog.dll,Rundll32EntryPointW"

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WUDFCoinstaller.dll"

[DestinationDirs]
UMDriverCopy=12,UMDF
WinBioAdapterCopy=11,WinBioPlugins

[UMDriverCopy]
EgisTouchFP05A5.dll
EgisTouchFPEventLog.dll

[WinBioAdapterCopy]
EgisTouchFPAdapter05A5.dll

[SignatureAttributes] 
EgisTouchFPAdapter05A5.dll = SignatureAttributes.WindowsHello
 
[SignatureAttributes.WindowsHello] 
WindowsHello = true 

