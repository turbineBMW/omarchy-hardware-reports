[Version]
Signature			= "$Windows NT$"
Class                   	= Extension
ClassGUID               	= {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId               	= {54057be9-f362-4b6d-82d4-37ebfc5fa078}
Provider = "ASUSTeK COMPUTER INC."
DriverVer = 01/29/2026,2.0.0.844
CatalogFile.NTARM64 = MyASUS_Splendid.cat

[SourceDisksNames]
1 = %DISK%,,,""

[SourceDisksFiles]
ASUS_DCIP3.icm=1
ASUS_DisplayP3.icm=1
ASUS_PowerSaving.json=1
ASUS_sRGB.icm=1
ConfigInstaller.xml=1
HT7407NA_QCOM_E5090D7B.icm=1
HT7407NA_QCOM_E5090D7B_CMDEF.icm=1
ForceUpdate.txt=1


[DestinationDirs]
DefaultDestDir  = 11
PackageCopy_Profiles = 23,AsusICM

[Manufacturer]
%MfgName% = DeviceExtensions,NTARM64

[DeviceExtensions.NTARM64]
AsusDisplay0 = AsusDisplay0.Inst, MONITOR\SDC41A0
AsusDisplay1 = AsusDisplay1.Inst, MONITOR\BOE0D7B

[AsusDisplay0.Inst]
CopyFiles=PackageCopy_Profiles
AddReg = AsusDisplay0.Inst.AddReg

[AsusDisplay0.Inst.AddReg]
HKR,,DisplayHdrLevel, %REG_MULTI_SZ_APPEND%, 4DDABBE3-5BC1-4F5C-9AA8-D611BC96F6ED,E55026B6-496B-4ACC-B371-A1211D829ABD

[AsusDisplay0.Inst.HW]
AddReg = AsusDisplay0.Inst.HW.AddReg;

[AsusDisplay0.Inst.HW.AddReg]
HKR,,FriendlyName,,%DeviceDescription%

[AsusDisplay1.Inst]
CopyFiles = PackageCopy_Profiles
AddReg = AsusDisplay1.Inst.AddReg;

[AsusDisplay1.Inst.AddReg]
HKR,,DisplayHdrLevel, %REG_MULTI_SZ_APPEND%, 4DDABBE3-5BC1-4F5C-9AA8-D611BC96F6ED,0E946CCB-FE35-4D22-A7E8-568FB06D145F

[AsusDisplay1.Inst.HW]
AddReg = AsusDisplay1.Inst.HW.AddReg;

[AsusDisplay1.Inst.HW.AddReg]
HKR,,FriendlyName,,%DeviceDescription%


[PackageCopy_Profiles]
ASUS_DCIP3.icm
ASUS_DisplayP3.icm
ASUS_PowerSaving.json
ASUS_sRGB.icm
ConfigInstaller.xml
HT7407NA_QCOM_E5090D7B.icm
HT7407NA_QCOM_E5090D7B_CMDEF.icm
ForceUpdate.txt


[NO_DRV64]
Include = machine.inf
Needs = NO_DRV
CopyFiles=PackageCopy_Profiles

[Strings]
MfgName = "ASUSTeK COMPUTER INC."
DISK   = "MyASUS Splendid INF"
REG_MULTI_SZ = 0x00010000
DeviceDescription = "MyASUS_Splendid"
REG_MULTI_SZ_APPEND = 0x00010008
